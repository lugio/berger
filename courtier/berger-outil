#!/usr/bin/env python3
"""berger-outil <outil> <verbe> [--stdin | --fichier .transport/requete.json]
Paramètres en tableau JSON UTF-8 : cinq textes au plus, un Mio au plus.
Un fichier de transport 600 dans .transport 700 est consommé et supprimé même en cas d'erreur.
Sans paramètre : omettre les options. Aucun contenu positionnel n'est accepté.
"""
import json
import os
import re
from pathlib import Path
import signal
import stat
import sys
import time
import uuid

MAXIMUM = 1024 * 1024


def interrompre(numero, cadre): raise SystemExit(128 + numero)


def lire_fichier(nom):
    """Consomme uniquement un fichier de la zone de transport locale ; noms neutres relatifs."""
    if not re.fullmatch(r'\.transport/[a-z0-9-]{1,64}\.json', nom):
        raise ValueError('nom de transport relatif requis')
    nom = Path(nom).name
    racine = os.open('.', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    dossier = None; cree = False
    reserve = '.' + uuid.uuid4().hex + '.tmp'
    try:
        dossier = os.open('.transport', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=racine)
        meta = os.fstat(dossier)
        if stat.S_IMODE(meta.st_mode) != 0o700 or meta.st_uid != os.getuid():
            raise ValueError('dossier de transport non privé')
        fd = os.open(reserve, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dossier)
        cree = True
        os.close(fd)
        os.rename(nom, reserve, src_dir_fd=dossier, dst_dir_fd=dossier)
        fd = os.open(reserve, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dossier)
        with os.fdopen(fd, 'rb') as flux:
            meta = os.fstat(flux.fileno())
            if (not stat.S_ISREG(meta.st_mode) or stat.S_IMODE(meta.st_mode) != 0o600
                    or meta.st_uid != os.getuid() or meta.st_nlink != 1):
                raise ValueError('fichier de transport non privé')
            brut = flux.read(MAXIMUM + 1)
        return brut
    finally:
        try:
            if cree: retirer(dossier, reserve)
        finally:
            if dossier is not None: os.close(dossier)
            os.close(racine)


def parametres(argv):
    if not argv: return []
    if argv == ['--stdin']: brut = sys.stdin.buffer.read(MAXIMUM + 1)
    elif len(argv) == 2 and argv[0] == '--fichier': brut = lire_fichier(argv[1])
    else: raise ValueError('paramètres positionnels refusés ; utiliser --stdin ou --fichier')
    if len(brut) > MAXIMUM: raise ValueError('entrée trop grande')
    try: valeurs = json.loads(brut.decode('utf-8'))
    except (ValueError, UnicodeError): raise ValueError('tableau JSON UTF-8 requis') from None
    if not isinstance(valeurs, list) or len(valeurs) > 5 or not all(isinstance(v, str) for v in valeurs):
        raise ValueError('cinq textes au plus requis')
    return valeurs


def dossier_agent():
    d = Path.cwd()
    while not (d / 'agent.conf').is_file():
        if d == d.parent:
            a = os.environ.get('BERGER_AGENT')
            b = Path(os.environ.get('BERGER_DIR', Path.home() / 'berger'))
            if a and (b / 'agents' / a / 'agent.conf').is_file(): return b / 'agents' / a
            raise ValueError("à lancer depuis le dossier d'un agent Berger")
        d = d.parent
    return d


def ouvrir_dossier(parent, nom):
    try: os.mkdir(nom, 0o700, dir_fd=parent)
    except FileExistsError: pass
    fd = os.open(nom, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    try:
        if os.fstat(fd).st_uid != os.getuid(): raise ValueError('dossier de courrier non conforme')
        os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd); raise


def existe(fd, nom):
    try: os.stat(nom, dir_fd=fd, follow_symlinks=False); return True
    except FileNotFoundError: return False


def retirer(fd, nom):
    try: os.unlink(nom, dir_fd=fd)
    except FileNotFoundError: pass


def lire_reponse(fd, nom):
    fichier = os.open(nom, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    with os.fdopen(fichier, 'rb') as flux:
        meta = os.fstat(flux.fileno())
        if (not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid()
                or stat.S_IMODE(meta.st_mode) != 0o600 or meta.st_nlink != 1):
            raise ValueError('réponse non privée')
        brut = flux.read(MAXIMUM + 1)
    if len(brut) > MAXIMUM: raise ValueError('réponse trop grande')
    try: rep = json.loads(brut.decode('utf-8'))
    except (ValueError, UnicodeError): raise ValueError('réponse JSON non conforme') from None
    if not isinstance(rep, dict) or not isinstance(rep.get('ok'), bool):
        raise ValueError('réponse non conforme')
    return rep


def main(argv):
    if len(argv) < 2: print(__doc__); return 2
    args = parametres(argv[2:])
    d = dossier_agent()
    fds = []
    i = uuid.uuid4().hex
    temporaire, nom = f'.{i}.tmp', f'{i}.json'
    demandes = reponses = None
    ancien = signal.getsignal(signal.SIGTERM)
    signal.signal(signal.SIGTERM, interrompre)
    try:
        agent = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW); fds.append(agent)
        boite = ouvrir_dossier(agent, 'courrier'); fds.append(boite)
        demandes = ouvrir_dossier(boite, 'demandes'); fds.append(demandes)
        reponses = ouvrir_dossier(boite, 'reponses'); fds.append(reponses)
        encours = ouvrir_dossier(boite, 'encours'); fds.append(encours)
        attente = ouvrir_dossier(boite, 'attente'); fds.append(attente)
        fd = os.open(temporaire, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o600, dir_fd=demandes)
        with os.fdopen(fd, 'w', encoding='utf-8') as flux:
            json.dump({'outil': argv[0], 'verbe': argv[1], 'args': args}, flux, ensure_ascii=False)
        os.rename(temporaire, nom, src_dir_fd=demandes, dst_dir_fd=demandes)
        # Le courtier doit prendre la demande en charge en 60 s (7 min 30 pour une délégation) ; ensuite, tant qu'elle est
        # EN COURS (courrier/encours/), on attend sa réponse jusqu'à 30 min (ex. les tests d'un projet). Rangée EN ATTENTE
        # (courrier/attente/ : le courtier redémarre, la demande est servie après) : les délais repartent de sa sortie.
        debut = time.monotonic()
        limite = float(os.environ.get('BERGER_OUTIL_PRISE', 450 if argv[0] == 'deleguer' else 60))
        while True:
            if existe(reponses, nom):
                rep = lire_reponse(reponses, nom)
                retirer(reponses, nom)
                print(json.dumps(rep, ensure_ascii=False))
                return 0 if rep['ok'] else 1
            if existe(attente, nom): debut = time.monotonic()
            ecoule = time.monotonic() - debut
            if ecoule > 1800 or (ecoule > limite and not existe(encours, nom)):
                raise ValueError('le courtier ne répond pas : délai dépassé')
            time.sleep(0.2)
    finally:
        try:
            if demandes is not None:
                retirer(demandes, temporaire); retirer(demandes, nom)
            if reponses is not None: retirer(reponses, nom)
        finally:
            for fd in reversed(fds): os.close(fd)
            signal.signal(signal.SIGTERM, ancien)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, interrompre)
    try: sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print(json.dumps({'ok': False, 'erreur': 'demande interrompue'}))
        sys.exit(130)
    except (ValueError, OSError):
        print(json.dumps({'ok': False, 'erreur': 'demande refusée ou réponse non conforme ; vérifier le format, les liens, les droits et le délai'}))
        sys.exit(2)
