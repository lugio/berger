class OutilWeb:
    contexte = _contexte.ContexteDeLAppel({})                        # posé par le courtier pour CET appel

    def __init__(self):
        self.verbes = {"etat": self.etat, "fermer": self.fermer}
        self.ecritures = {"demander": (self.apercu_demander, self.ouvrir), "prolonger": (self.apercu_prolonger, self.prolonger),
                          "remettre": (self.apercu_remettre, self.remettre)}
        b = CONFIG.get("bibliotheque") or {}
        racine = Path(os.path.expanduser(b["racine"])) if b.get("racine") else BERGER / "bibliotheque"
        self.relais = _web_relais.Relais(BERGER, racine, EQUIPES, contient_secret, mission_rapport_web)

    def agent(self): return self.contexte.get("agent", "")

    def valideur(self, verbe, args): return None                  # propriétaire seul, aucune validation déléguée

    def apercu_remettre(self, args):
        """remettre <projet> <rapport.md> : rapport sous analyses, dépôt et mission au chef après validation propriétaire"""
        return self.relais.apercu(self.agent(), args)

    def remettre(self, args):
        return self.relais.executer(self.agent(), args)

    def en_attente(self, agent, verbe):
        """Le n° d'une demande web de cet agent encore en attente (None sinon)."""
        for f in VALIDATIONS.glob("*.json") if VALIDATIONS.is_dir() else []:
            try: d = json.loads(f.read_text()) if f.stem.isdigit() else {}
            except (OSError, ValueError): continue
            if d.get("agent") == agent and d.get("outil") == "web" and d.get("verbe") == verbe: return d.get("n")
        return None

    def apercu_demander(self, args):
        """demander <domaine>[,<sous-domaine>…] "<motif>" [durée] : accès web à CE domaine (GET/HEAD, 2 h par défaut, 24 h au plus)"""
        a = self.agent()
        if len(args) < 2 or not args[1].strip(): raise ValueError('web demander <domaine> "<motif>" [durée, ex. 2h]')
        if contient_secret(" ".join(args)): raise ValueError("demande refusée : elle contient un secret (valeur du coffre ou forme de clé)")
        noms, s, session = _web.demande(args)
        if WEB.ouvert(a): raise ValueError(f"un accès web est déjà ouvert ({WEB.ouvert(a)['noms'][0]}) : un à la fois (web fermer, ou l'échéance)")
        if self.en_attente(a, "demander"): raise ValueError(f"une demande d'accès web est déjà en attente (n° {self.en_attente(a, 'demander')})")
        return (f"ouvrir l'accès web de {a} à {', '.join(noms)} pendant {_web.libelle(s)} (GET et HEAD ; motif : {args[1].strip()[:80]}) — "
                + ((f"prêter ta session en lecture seule ; connecter d’abord : berger web connecter {noms[0]} — " if session else "") + f"CGU de {noms[0]} vérifiées ? Durée réglable : berger valider <n°> --duree 8h (24 h au plus)"))

    def ouvrir(self, args):
        noms, secondes, session = _web.demande(args)
        return WEB.ouvrir(self.agent(), noms, secondes, session=session)

    def apercu_prolonger(self, args):
        """prolonger <domaine> [durée] : prolonger l'accès web ouvert (2 h par défaut, 24 h au plus par go)"""
        if contient_secret(" ".join(args)): raise ValueError("demande refusée : elle contient un secret (valeur du coffre ou forme de clé)")
        a = self.agent(); dom = _web.noms(args[0] if args else "")[0]; s = _web.duree(args[1] if len(args) > 1 else "")
        o = WEB.ouvert(a)
        if not o or o["noms"][0] != dom: raise ValueError(f"aucun accès web ouvert à {dom} : web demander")
        if self.en_attente(a, "prolonger"): raise ValueError(f"une prolongation est déjà en attente (n° {self.en_attente(a, 'prolonger')})")
        return f"prolonger de {_web.libelle(s)} l'accès web de {a} à {dom} — durée réglable : berger valider <n°> --duree 8h (24 h au plus)"

    def prolonger(self, args):
        return WEB.prolonger(self.agent(), _web.noms(args[0])[0], _web.duree(args[1] if len(args) > 1 else ""))

    def ajuster(self, verbe, args, options):
        """La durée fixée par le valideur (`berger valider <n> --duree`) remplace celle de la demande ; 24 h au plus."""
        if verbe not in ("demander", "prolonger"): raise ValueError("ce verbe ne permet aucun réglage de durée")
        if set(options) - {"duree"}: raise ValueError(f"réglage inconnu : {', '.join(sorted(set(options) - {'duree'}))}")
        _web.duree(options["duree"])
        if verbe == "demander":
            _, _, session = _web.demande(args)
            return list(args[:2]) + [options["duree"]] + (["--session"] if session else [])
        k = 1
        args = list(args) + [""] * (k + 1 - len(args)); args[k] = options["duree"]
        return args

    def etat(self, args):
        """etat : ton accès web ouvert (domaine, échéance, adresse du proxy)"""
        o = WEB.ouvert(self.agent())
        if not o: return "aucun accès web ouvert"
        return {"noms": o["noms"], "fin": datetime.datetime.fromtimestamp(o["fin_ts"]).isoformat(timespec="minutes"),
                "proxy": str(WEB.chemin(self.agent())), "methodes": list(_web.METHODES), "session": o.get("session", False)}

    def fermer(self, args):
        """fermer : ferme ton accès web avant l'échéance"""
        return "accès fermé" if WEB.fermer(self.agent(), "par l'agent") else "aucun accès web ouvert"


