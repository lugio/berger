def droits_mcp(agent): return {x.strip() for x in reglage(agent, "mcp").split(",") if x.strip()}


def session_mcp(agent, c):
    lecture = c.makefile("rb")
    def fermer():
        try: c.close()
        except OSError: pass
    _mcp.session(agent, lecture, c.sendall, fermer, droits_mcp(agent), BERGER / "bin/berger", _commandes.bac_a_sable, masques_courtier(),
                 contient_secret, journal, lambda titre, texte: notifier_proprietaire(titre, texte, urgent=True))


def ecouter_mcp(agent):
    import socket
    f = SOCKETS_MCP / f"{agent}.sock"; f.unlink(missing_ok=True)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.bind(str(f)); os.chmod(f, 0o600); s.listen(16)
    while True:
        c, _ = s.accept()
        threading.Thread(target=session_mcp, args=(agent, c), daemon=True).start()


def sockets_mcp():
    """Ouvre l'écoute de chaque agent qui a un `mcp =` (vérifié à chaque tour : un agent créé ensuite l'a aussi)."""
    for d in sorted(AGENTS.iterdir()) if AGENTS.is_dir() else []:
        if d.name in ECOUTE_MCP or not (d / "agent.conf").is_file() or not droits_mcp(d.name): continue
        SOCKETS_MCP.mkdir(mode=0o700, parents=True, exist_ok=True)
        ECOUTE_MCP[d.name] = threading.Thread(target=ecouter_mcp, args=(d.name,), daemon=True); ECOUTE_MCP[d.name].start()


