def expirer_web():
    """Une demande d'accès web sans décision depuis WEB_ATTENTE expire : rien n'est ouvert, le demandeur l'apprend."""
    for f in VALIDATIONS.glob("*.json") if VALIDATIONS.is_dir() else []:
        if not f.stem.isdigit() or any((VALIDATIONS / f"{f.stem}{x}").exists() for x in (".decision", ".execution", ".fait.json")): continue
        try: d = json.loads(f.read_text()); age = time.time() - f.stat().st_mtime
        except (OSError, ValueError): continue
        if d.get("outil") != "web" or age < WEB_ATTENTE: continue
        d.update(etat="expiré", resultat=None, decide=datetime.datetime.now().isoformat(timespec="minutes"), par="personne (sans réponse)")
        with os.fdopen(os.open(VALIDATIONS / f"{f.stem}.fait.json", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as flux:
            os.fchmod(flux.fileno(), 0o600)
            flux.write(json.dumps(d, ensure_ascii=False, indent=1))
        f.unlink(missing_ok=True)
        apercu = str(d.get("apercu", ""))
        if contient_secret(apercu): apercu = "(aperçu masqué : il contenait un secret)"     # jamais un secret au journal de l'agent
        journal_agent(d.get("agent", "?"), f"demande n° {d.get('n')} EXPIRÉE sans réponse ({_web.libelle(WEB_ATTENTE)}) : {apercu} — rien n'est ouvert")
        journal(d.get("agent", "?"), "web", d.get("verbe", "?"), d.get("args", []), False, f"validation n° {d.get('n')} : expirée")


