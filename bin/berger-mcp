#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""berger-mcp <agent> <serveur> — le SEUL serveur MCP qu'un moteur (Claude, Codex) lance pour un agent strict
(berger-mcp, 18/10/2026, docs/plans/2026-10-18-berger-mcp-spec.md).

Un simple relais stdio ↔ courtier : il se connecte au socket de l'agent (courtier/mcp/<agent>.sock, masqué à tous les
agents), demande le serveur, puis recopie les octets dans les deux sens. Il ne lit ni le coffre ni config.toml, ne lance
rien : le courtier vérifie le droit, lance le vrai serveur ENFERMÉ, journalise et filtre chaque réponse.
Refus du courtier : le message sur la sortie d'erreur, code 1."""
import json, os, socket, sys, threading
from pathlib import Path

BERGER = Path(__file__).resolve().parent.parent          # jamais une variable d'environnement : le moteur passe la sienne


def main():
    if len(sys.argv) != 3: sys.exit(__doc__)
    agent, serveur = sys.argv[1], sys.argv[2]
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try: s.connect(str(BERGER / "courtier/mcp" / f"{agent}.sock"))
    except OSError as e: sys.exit(f"berger-mcp : courtier injoignable pour {agent} ({e.strerror}) — est-il lancé ? systemctl --user status berger-courtier")
    s.sendall(json.dumps({"serveur": serveur}).encode() + b"\n")
    lecture = s.makefile("rb")
    try: rep = json.loads(lecture.readline(4096) or b"{}")
    except ValueError: rep = {}
    if not rep.get("ok"): sys.exit(f"berger-mcp : refusé — {rep.get('erreur', 'réponse illisible du courtier')}")

    def vers_courtier():
        entree = sys.stdin.buffer
        while True:
            b = entree.read1(65536)
            if not b: break
            s.sendall(b)
        try: s.shutdown(socket.SHUT_WR)                    # fin de la session côté moteur : le courtier arrête le serveur
        except OSError: pass
    threading.Thread(target=vers_courtier, daemon=True).start()
    sortie = sys.stdout.buffer
    while True:
        b = lecture.read1(65536)
        if not b: break
        sortie.write(b); sortie.flush()
    os._exit(0)


if __name__ == "__main__":
    main()
