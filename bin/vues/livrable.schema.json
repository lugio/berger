    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "branche": {
   "x-libelle": "Branche",
   "x-rendu": "texte",
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "chemin": {
   "x-libelle": "Chemin",
   "x-rendu": "texte",
   "type": "string"
  },
  "genre": {
   "x-libelle": "Genre",
   "x-rendu": "texte",
   "type": "string",
   "enum": [
    "md",
    "html",
    "pdf",
    "png",
    "jpeg",
    "gif",
    "webp",
    "autre"
   ]
