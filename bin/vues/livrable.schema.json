   "x-rendu": "cache",
   "type": "string"
  },
  "titre": {
   "x-libelle": "Titre",
   "x-rendu": "texte",
   "type": "string"
  },
  "auteur": {
   "x-libelle": "Auteur",
   "x-rendu": "agent",
   "anyOf": [
    {
     "$ref": "communs.schema.json#/$defs/Agent"
    },
    {
     "type": "null"
    }
   ]
  },
  "origine": {
   "x-libelle": "Origine",
   "x-rendu": "texte",
   "type": "string",
   "enum": [
    "commun",
    "projet",
    "travail",
    "a_lire",
    "branche"
   ]
  },
  "projet": {
   "x-libelle": "Projet",
   "x-rendu": "texte",
