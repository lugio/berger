     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "tronque": {
   "x-libelle": "Coupé",
   "x-rendu": "oui-non",
   "type": "boolean"
  }
 },
 "required": [
  "id",
  "titre",
  "auteur",
  "origine",
  "projet",
  "branche",
  "chemin",
  "genre",
  "taille",
  "date",
  "texte",
  "tronque"
 ],
