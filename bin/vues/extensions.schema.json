   "required": ["genre", "nom", "version", "empreinte", "description", "agents", "droits", "reseau", "installee", "dernier_usage", "etat"], "additionalProperties": false}}
 },
 "required": ["fichier", "lisible", "signalements", "extensions"], "additionalProperties": false
}
