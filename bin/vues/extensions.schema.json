   "required": ["quoi", "consequence", "ton"], "additionalProperties": false}},
  "extensions": {"x-libelle": "Extensions", "x-rendu": "liste", "type": "array", "items": {"type": "object",
   "properties": {"genre": {"x-libelle": "Genre", "x-rendu": "texte", "type": "string", "enum": ["skill", "mcp", "vue", "outil"]},
                  "nom": {"x-libelle": "Nom", "x-rendu": "texte", "type": "string"},
                  "version": {"x-libelle": "Version", "x-rendu": "texte", "type": "string"},
                  "empreinte": {"x-libelle": "Empreinte", "x-rendu": "texte", "type": "string"},
