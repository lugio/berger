def main(argv, prive=False):
    if argv == ["--stdin"]:
        if prive: raise ValueError("commande privée imbriquée refusée")
        try: valeurs = json.loads(entree_privee())
        except ValueError: raise ValueError("commande JSON invalide") from None
        if (not isinstance(valeurs, list) or not valeurs or len(valeurs) > 64
                or not all(isinstance(v, str) for v in valeurs) or valeurs[0] == "--stdin"):
            raise ValueError("commande privée : tableau de textes requis")
        return main(valeurs, prive=True)
    if not argv or argv[0] in ("-h", "--help", "aide"): print(__doc__); return
    cmd, args = argv[0], argv[1:]
    if not prive and commandes.prive(cmd):
        sys.exit("usage : berger --stdin ; commande et paramètres dans un tableau JSON UTF-8, texte positionnel refusé")
    if commandes.lancer(cmd, args, prive) is NotImplemented: sys.exit(commandes.inconnue(cmd, __doc__))


def commande_vue(args):
    """berger vue <type> [agent|filtre] [--json] : le texte de la vue (une fois, à la largeur du terminal) ou ses données."""
    en_json = "--json" in args; pos = [x for x in args if x != "--json"]
    if not pos: sys.exit("berger vue <type> [agent|filtre] [--json]   (les vues : berger vues)")
    vue = {"ensemble": "accueil", "source": "sources"}.get(pos[0], pos[0]); a = pos[1] if len(pos) > 1 else None
    if vue not in VUES: sys.exit(f"vue inconnue : {pos[0]}" + (f" (écartée : {VUES_REFUSEES[vue]})" if vue in VUES_REFUSEES else f" — vues : {', '.join(sorted(VUES))}"))
    m = VUES[vue]
    if m.ONGLET == "agent" and a not in agents(): sys.exit(f"vue d'agent : berger vue {vue} <agent> (agents : {', '.join(agents())})")
    try:
        if not en_json:
            w, h = _sh.get_terminal_size((100, 40)); print("\n".join(m.rendre(max(40, w - 1), h, a))); return 0
        if not hasattr(m, "donnees"): sys.exit(f"vue {vue} : pas encore de données JSON (séparation données/rendu en cours, spec interface, lot 0)")
        print(json.dumps(enveloppe(vue, Path(m.__file__).with_suffix(".schema.json"), m.donnees(a)), ensure_ascii=False, indent=1)); return 0
    except ValueError as e: sys.exit(str(e))                                # objet inconnu (vue d'objet) : refus clair


JETON_INTERFACE = HOME / ".config/berger/interface.jeton"                  # dossier masqué à tous les agents (comme le coffre)


DOSSIER_TLS = HOME / ".config/berger/interface"                             # certificat interne (lot 1c) : masqué aux agents
CERTIFICAT_INTERFACE, CLE_INTERFACE = DOSSIER_TLS / "certificat.pem", DOSSIER_TLS / "cle.pem"
NOM_DNS = re.compile(r"(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}")


def reglages_interface():
    """[interface] de config.toml, contrôlé (spec interface §6 ter) : port (8765), adresse d'écoute (IP littérale, jamais
    « partout » ; défaut 127.0.0.1), nom public (derrière SWAG), sources admises (IP ; défaut 127.0.0.1), tls. Réglage faux :
    refus clair, rien n'écoute."""
    import ipaddress
    c = CONFIG.get("interface") or {}
    def ip(x, quoi):
        try: a = ipaddress.ip_address(str(x))
        except ValueError: sys.exit(f"[interface] {quoi} : « {str(x)[:60]} » n'est pas une adresse IP (jamais un nom d'hôte)")
        if a.is_unspecified: sys.exit(f"[interface] {quoi} : {a} veut dire « partout » — une adresse précise (celle de la VM)")
        return str(a)
    nom = c.get("nom") or None
    if nom is not None and not NOM_DNS.fullmatch(str(nom)): sys.exit(f"[interface] nom : « {str(nom)[:60]} » n'est pas un nom de domaine exact")
    sources = c.get("sources", ["127.0.0.1"])
    if not isinstance(sources, list) or not sources: sys.exit("[interface] sources : une liste d'adresses IP (ex. [\"<adresse source de SWAG>\"])")
    return {"port": int(c.get("port", 8765)), "adresse": ip(c.get("adresse", "127.0.0.1"), "adresse"), "nom": nom,
            "sources": [ip(x, "sources") for x in sources], "tls": c.get("tls") is True}


def port_interface():
    return reglages_interface()["port"]


def certificat_etat():
    """(état, texte) du certificat interne : « absent », « expire » (date passée), « bientot » (≤ 30 jours), « ok ».
    Lu par openssl (présent sur la machine) : dates et empreinte SHA-256, jamais la clé."""
    if not CERTIFICAT_INTERFACE.is_file(): return "absent", f"aucun certificat interne ({CERTIFICAT_INTERFACE}) : berger interface certificat"
    r = subprocess.run(["openssl", "x509", "-noout", "-enddate", "-fingerprint", "-sha256", "-in", str(CERTIFICAT_INTERFACE)],
                       capture_output=True, text=True)
    fin = re.search(r"notAfter=(.+)", r.stdout); emp = re.search(r"Fingerprint=([0-9A-F:]+)", r.stdout)
    if r.returncode or not fin: return "expire", f"certificat interne illisible ({(r.stderr or r.stdout).strip()[:120]}) : berger interface certificat --nouveau"
    echeance = datetime.datetime.strptime(fin.group(1).strip().replace("  ", " "), "%b %d %H:%M:%S %Y GMT").replace(tzinfo=datetime.timezone.utc)
    jours = (echeance - datetime.datetime.now(datetime.timezone.utc)).days; quand = echeance.astimezone().strftime("%d/%m/%Y")
    texte = f"empreinte SHA-256 {emp.group(1) if emp else '?'}"
    if echeance <= datetime.datetime.now(datetime.timezone.utc): return "expire", f"⚠ certificat interne EXPIRÉ le {quand} : berger interface certificat --nouveau, puis le redéposer chez SWAG ({texte})"
    if jours <= 30: return "bientot", f"⚠ certificat interne : expire dans {jours} jour(s), le {quand} — à renouveler (berger interface certificat --nouveau, puis SWAG) ({texte})"
    return "ok", f"certificat interne valable jusqu'au {quand} ({texte})"


def interface_certificat(nouveau=False):
    """Le certificat INTERNE de l'interface (TLS de SWAG jusqu'à la VM) : créé par openssl (clé EC P-256, auto-signé, 397
    jours, CN et DNS = [interface] nom, IP = [interface] adresse) dans un dossier masqué aux agents, clé en 600. Jamais
    écrasé sans --nouveau ; affiche l'état et l'empreinte, jamais la clé. Propriétaire seul."""
    if os.environ.get("BERGER_AGENT"): sys.exit("berger interface certificat : réservé au propriétaire, jamais à un agent")
    if CERTIFICAT_INTERFACE.is_file() and not nouveau: print(certificat_etat()[1]); return 0
    r = reglages_interface()
    if not r["nom"]: sys.exit("déclare d'abord [interface] nom (et adresse) dans config.toml : le certificat les porte")
    DOSSIER_TLS.mkdir(parents=True, exist_ok=True, mode=0o700); os.chmod(DOSSIER_TLS, 0o700)
    cle, cert = DOSSIER_TLS / ".cle.tmp", DOSSIER_TLS / ".certificat.tmp"
    for f in (cle, cert): f.unlink(missing_ok=True)
    masque = os.umask(0o077)                                               # la clé naît en 600, jamais lisible un instant
    try:
        o = subprocess.run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256", "-nodes", "-days", "397",
                            "-subj", f"/CN={r['nom']}", "-addext", f"subjectAltName=DNS:{r['nom']},IP:{r['adresse']}",
                            "-keyout", str(cle), "-out", str(cert)], capture_output=True, text=True)
    finally: os.umask(masque)
    if o.returncode or not cle.is_file() or not cert.is_file():
        for f in (cle, cert): f.unlink(missing_ok=True)
        sys.exit(f"certificat NON créé : openssl en échec ({(o.stderr or o.stdout).strip()[-200:]})")
    os.chmod(cle, 0o600); os.chmod(cert, 0o644); os.replace(cle, CLE_INTERFACE); os.replace(cert, CERTIFICAT_INTERFACE)
    print(f"certificat interne créé : {CERTIFICAT_INTERFACE} (clé en 600, jamais affichée) — {certificat_etat()[1]}")
    print("à déposer chez SWAG (le certificat, PAS la clé), puis relancer le service berger-interface", file=sys.stderr)
    return 0


def interface_lien(nouveau=False):
    """Le lien d'entrée de l'interface web (propriétaire seul) : https://<nom>/#jeton=… derrière SWAG, sinon
    http://localhost:<port>/#jeton=… (tunnel) — le jeton est dans le fragment, jamais envoyé dans l'adresse. Créé au premier
    appel ; --nouveau le change (toute session ouverte tombe). Signale un certificat interne expiré ou proche de l'échéance."""
    if os.environ.get("BERGER_AGENT"): sys.exit("berger interface lien : réservé au propriétaire, jamais à un agent")
    import secrets
    r = reglages_interface()
    if nouveau or not JETON_INTERFACE.is_file():
        JETON_INTERFACE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        tmp = JETON_INTERFACE.with_suffix(".tmp"); tmp.unlink(missing_ok=True)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f: f.write(secrets.token_urlsafe(32) + "\n")
        os.replace(tmp, JETON_INTERFACE)
    base = f"https://{r['nom']}/" if r["nom"] else f"{'https' if r['tls'] else 'http'}://localhost:{r['port']}/"
    print(f"{base}#jeton={JETON_INTERFACE.read_text().strip()}")
    if r["tls"]:
        etat, texte = certificat_etat()
        if etat != "ok": print(texte, file=sys.stderr)
    if r["nom"]: print("(depuis le réseau du cabinet ou le VPN ; à ne pas transmettre)", file=sys.stderr)
    else: print("(depuis ton poste : ssh -L {0}:127.0.0.1:{0} <la VM>, puis ce lien dans le navigateur ; à ne pas transmettre)".format(r["port"]), file=sys.stderr)


# ───────────────────────────── vues : un fichier par vue dans bin/vues/ (07/10/2026) ─────────────────────────────
# Ajouter une vue = déposer bin/vues/<type>.py avec TITRE, ICONE, ONGLET ("berger" | "agent"), ORDRE et rendre(w, h, a=None).
# Le cœur ne connaît aucune vue par son nom : il lit le dossier, en déduit ONGLETS_BERGER et les icônes, et `berger panneau
# <type>` appelle rendre. Une vue qui ne charge pas (erreur, constante manquante) est ÉCARTÉE et NOMMÉE (berger etat, berger
# panneau) ; les autres s'affichent. Chaque vue reçoit l'API du noyau (bin/noyau/api.py) et la bibliothèque standard, rien d'autre.


def charger_vues():
    global ONGLETS_BERGER
    import importlib.util
    for f in sorted((Path(__file__).resolve().parent / "vues").glob("*.py")):   # à côté du programme, pas de l'installation
        if f.name.startswith("_"): continue
        try:
            spec = importlib.util.spec_from_file_location(f"vue_{f.stem}", f); mod = importlib.util.module_from_spec(spec)
            mod.__dict__.update(espace_api(globals()))                  # l'API du noyau, rien d'autre (noyau/api.py)
            spec.loader.exec_module(mod)
            for c in ("TITRE", "ICONE", "ONGLET", "ORDRE"):
                if not hasattr(mod, c): raise AttributeError(f"constante {c} absente")
            if not callable(getattr(mod, "rendre", None)): raise AttributeError("fonction rendre(w, h, a=None) absente")
            if hasattr(mod, "donnees"):                                   # vue séparée : son texte et son schéma vont avec
                if not callable(getattr(mod, "rendu_texte", None)): raise AttributeError("donnees() sans rendu_texte(d, w, h)")
                sch = f.with_suffix(".schema.json")
                if not sch.is_file(): raise AttributeError(f"donnees() sans schéma ({sch.name})")
                json.loads(sch.read_text())
        except Exception as e:
            VUES_REFUSEES[f.stem] = f"{type(e).__name__}: {e}"; continue
        VUES[f.stem] = mod
        if mod.ONGLET == "berger" and mod.ICONE: ICONES_ONGLETS[mod.TITRE] = mod.ICONE
    ONGLETS_BERGER = tuple((m.TITRE, t) for t, m in sorted(VUES.items(), key=lambda x: x[1].ORDRE)
                           if m.ONGLET == "berger" and t != "accueil")   # l'Accueil est le premier onglet, créé avec l'espace


moteurs.brancher(consigne_systeme=consigne_systeme, ecrire_mcp_claude=ecrire_mcp_claude,
                 ecrire_reseau_claude=ecrire_reseau_claude, env_appelant=env_appelant, reglages_strict_externe=reglages_strict_externe,
                 AU_REPOS=AU_REPOS)   # ce qui reste au cœur jusqu'au lot 4 (mur, MCP, secrets) ; AU_REPOS : lot 3
moteurs.charger(globals())
charger_vues()


commandes.charger(globals(), VERBES_COEUR)   # l'API du noyau seule ; les verbes du cœur (lot 4) sont inscrits au même registre

if __name__ == "__main__":
    main(sys.argv[1:])
