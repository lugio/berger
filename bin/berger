# ─── Les verbes qui restent au cœur jusqu'au lot 4 (modulaire, lot 3) : le corps de chacun est celui de l'ancien main(), enveloppé dans une
# fonction (args, prive=False) ; bin/commandes/transition.py les inscrit dans le MÊME registre que les familles (VERBES_COEUR ci-dessous).
# Une fonction rend NotImplemented quand la forme demandée n'est pas la sienne (« commande inconnue », comme avant). ───

def _opt(args, nom): return args[args.index(nom) + 1] if nom in args else None

def verbe_nouveau(args, prive=False): nouveau(args[0], args[1] if len(args) > 1 else None)
def verbe_regenerer(args, prive=False): regenerer()
def verbe_lancer(args, prive=False): lancer(args[0], args[1] if len(args) > 1 else None)

def verbe_demander(args, prive=False):
    opt = lambda nom: _opt(args, nom)
    if not args:
        sys.exit("usage : berger demander <agent> --stdin [--moteur m] [--sortie f]")
    if len(args) < 2 or args[1] != "--stdin":
        raise ValueError("berger demander <agent> --stdin [--moteur m] [--sortie f] ; texte positionnel refusé")
    reste = args[2:]
    if len(reste) % 2 or any(reste[i] not in ("--moteur", "--sortie") for i in range(0, len(reste), 2)):
        raise ValueError("options de demander invalides")
    texte, m, echecs = demander(args[0], entree_privee(), opt("--moteur"), opt("--sortie"))
    for e in echecs: print(e, file=sys.stderr)
    print(f"moteur : {m or 'aucun'}", file=sys.stderr); print(texte); sys.exit(0 if m else 1)

