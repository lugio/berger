def verbe_espace(args, prive=False): espace(args[0])

def verbe_interface(args, prive=False):
    if args[:1] == ["lien"]: interface_lien("--nouveau" in args)
    elif args[:1] == ["certificat"]: sys.exit(interface_certificat("--nouveau" in args))
    elif args[:1] == ["servir"]:                  # le service berger-interface (Python standard, lecture seule)
        r = reglages_interface()
        argv = [sys.executable, str(Path(__file__).resolve().parent / "interface.py"), "servir", str(r["port"]), str(JETON_INTERFACE),
                "--adresse", r["adresse"], "--sources", ",".join(r["sources"])] + (["--nom", r["nom"]] if r["nom"] else [])
        if r["tls"]:
            etat_c, texte = certificat_etat()                              # (pas « etat » : ce nom est la commande berger etat)
            print(texte, file=sys.stderr, flush=True)                      # au démarrage, dans le journal du service
            if etat_c == "absent": sys.exit("[interface] tls = true sans certificat interne : berger interface certificat")
            argv += ["--tls", str(CERTIFICAT_INTERFACE), str(CLE_INTERFACE)]
        os.execv(sys.executable, argv)
    else: return NotImplemented

def verbe_web(args, prive=False): web_commande(args)
def verbe_crochet_equipe(args, prive=False): lancer_crochet_equipe(args[0])            # appelé par le moteur (crochet d'un développeur)

