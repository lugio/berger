def verbe_verifier_sauvegarde(args, prive=False): sys.exit(verifier_sauvegarde())
def verbe_moteur(args, prive=False): moteur_a_la_demande(args[0], args[1])

def verbe_parler(args, prive=False):
    if len(args) < 2 or args[1] != "--stdin":
        raise ValueError("berger parler <agent> --stdin [--moteur m] [--de qui] [--sans-echange] ; texte positionnel refusé")
    options = {}; reste = iter(args[2:])
    for x in reste:
        if x not in ("--moteur", "--de", "--sans-echange") or x in options:
            raise ValueError("options de parler invalides")
        valeur = True if x == "--sans-echange" else next(reste, None)
        if valeur is None or (isinstance(valeur, str) and valeur.startswith("--")):
            raise ValueError("option de parler sans valeur")
        options[x] = valeur
    parler(args[0], entree_privee(), options.get("--moteur"),
           de=False if "--sans-echange" in options else options.get("--de"))

def verbe_superviser(args, prive=False): superviser(); print("supervision faite")
def verbe_message_deposer(args, prive=False): print(message_deposer(args[0], args[1], " ".join(args[2:])))   # usage interne (courtier, berger-outil ecrire)
def verbe_annonce_outil(args, prive=False): print(annonce_outil(args[0], "--premiere" in args))   # usage interne (courtier : consigne d'un outil changée)
def verbe_besoin_ranger(args, prive=False): print(besoin_ranger(args[0], args[1], " ".join(args[2:])))   # usage interne (courtier, berger-outil besoin)

def verbe_besoin(args, prive=False):
    opt = lambda nom: _opt(args, nom)
    if args[:1] == ["clore"] and len(args) >= 3:     # berger besoin clore <n°> fait|refuse|transmis "<suite>" [--par <gardien>]
        reste = [x for i, x in enumerate(args[3:]) if x != "--par" and (i == 0 or args[3:][i - 1] != "--par")]
        print(besoin_clore(args[1], args[2], " ".join(reste).strip(), opt("--par")))
    elif args[:1] in ([], ["liste"]):
        l = besoins()
        if "--json" in args: print(json.dumps(l, ensure_ascii=False, indent=1))
        else: print("\n".join(f"n° {b['n']}  {b['quand'][:16].replace('T', ' ')}  {b['de']} → {b.get('a', '?')}  [{b['genre']}] {b['texte']}" for b in l) or "aucun besoin ouvert")
    else: return NotImplemented

def verbe_message_remettre(args, prive=False): print("file vide" if message_remettre(args[0]) else "messages en attente")   # usage interne
def verbe_delegation_suivi(args, prive=False): print(delegation_suivi(args[0], args[1], json.loads(sys.stdin.read())))  # usage interne (courtier, deleguer)
def verbe_echange(args, prive=False):                                 # usage interne (courtier, outils d'équipe) : de a genre texte
    echange(args[0], args[1], args[2], sys.stdin.read() if args[3:] == ["--stdin"] else " ".join(args[3:]))

def verbe_parler_interactif(args, prive=False):                       # pour la fenêtre Herdr prefix+a
    noms = agents(); print("À qui parler ?  " + "   ".join(f"{i + 1}. {conf(x)['icone']} {conf(x)['nom']}" for i, x in enumerate(noms)))
    try:
        choix = noms[int(input("numéro : ")) - 1]; msg = input(f"message pour {conf(choix)['nom']} : ").strip()
        if msg: parler(choix, msg)
    except (ValueError, IndexError, EOFError): print("annulé")

def verbe_entretien(args, prive=False): print(f"{entretien()} fichier(s) rangé(s)")
def verbe_valider(args, prive=False): decider(args[0], "valider", _opt(args, "--duree"))
def verbe_refuser(args, prive=False): decider(args[0], "refuser", _opt(args, "--duree"))
def verbe_mission(args, prive=False):                                 # berger mission <agent> "<texte>" [--par <qui>]
    opt = lambda nom: _opt(args, nom)
    reste, i = [], 1
    while i < len(args):
        if args[i] in ("--par", "--moteur", "--modele"): i += 2; continue
        reste.append(args[i]); i += 1
    print(mission(args[0], " ".join(reste), opt("--par") or PROPRIETAIRE, opt("--moteur"), opt("--modele")))

def verbe_suivi(args, prive=False): print(json.dumps(suivi(args[0]), ensure_ascii=False, indent=1))
def verbe_rapport_mission(args, prive=False): print(json.dumps(rapport_mission(args[0]), ensure_ascii=False, indent=1))
def verbe_equipe(args, prive=False):                                  # ouvrir <projet> <sujet> "<mission>" | fermer <projet> <sujet> | liste <projet>
    opt = lambda nom: _opt(args, nom)
    q = args[1:]; pos, i = [], 0                                      # | domaine <projet> ajouter|retirer <nom> [--essai] | domaines <projet>
    while i < len(q):
        if q[i] in ("--par", "--moteur", "--modele"): i += 2; continue
        if q[i] != "--essai": pos.append(q[i])
        i += 1
    usage = ("berger equipe ouvrir <projet> <sujet> \"<mission>\" | fermer <projet> <sujet> | liste <projet> | domaine <projet> "
             f"ajouter|retirer <nom> [--essai] | domaines <projet> | go <projet> <sujet> <cas> <spec> [--essai] — équipes : {', '.join(EQUIPES) or 'aucune'}")
    besoin = {"ouvrir": 2, "fermer": 2, "liste": 1, "domaine": 3, "domaines": 1, "go": 4}
    if not args or args[0] not in besoin or len(pos) < besoin[args[0]]: sys.exit(usage)
    if pos[0] not in EQUIPES: sys.exit(f"projet d'équipe inconnu : {pos[0]} — {usage}")
    if args[0] == "ouvrir": print(equipe_ouvrir(pos[0], pos[1], " ".join(pos[2:]), opt("--par") or PROPRIETAIRE, opt("--moteur"), opt("--modele")))
    elif args[0] == "fermer": print(equipe_fermer(pos[0], pos[1], opt("--par") or PROPRIETAIRE))
    elif args[0] == "liste": print(json.dumps(equipe_liste(pos[0]), ensure_ascii=False, indent=1))
    elif args[0] == "domaine" and len(pos) == 3: print(equipe_domaine(pos[0], pos[1], pos[2], opt("--par") or PROPRIETAIRE, "--essai" in args))
    elif args[0] == "go" and len(pos) == 4: print(equipe_go(*pos, opt("--par") or PROPRIETAIRE, "--essai" in args))
    elif args[0] == "domaines" and len(pos) == 1: print(json.dumps(domaines_projet(pos[0], signaler=False)))
    else: sys.exit(usage)

def verbe_projet(args, prive=False):                                  # ouvrir <équipe> <projet> <membres> | fermer <équipe> <projet> | liste [<équipe>]
    opt = lambda nom: _opt(args, nom)
    q = [x for i, x in enumerate(args[1:]) if x != "--par" and (i == 0 or args[1:][i - 1] != "--par")]
    if args[:1] == ["ouvrir"] and len(q) == 3: print(projet_ouvrir(q[0], q[1], q[2], opt("--par") or PROPRIETAIRE))
    elif args[:1] == ["fermer"] and len(q) == 2: print(projet_fermer(q[0], q[1], opt("--par") or PROPRIETAIRE))
    elif args[:1] == ["liste"]: print(json.dumps(projet_liste(q[0] if q else None), ensure_ascii=False, indent=1))
    else: sys.exit("berger projet ouvrir <équipe> <projet> <membre,membre…> | fermer <équipe> <projet> | liste [<équipe>]")

def verbe_fin_mission(args, prive=False): print(fin_mission(args[0], _opt(args, "--par") or PROPRIETAIRE, _opt(args, "--motif")))

def verbe_installer(args, prive=False):
    if not 1 <= len(args) <= 2: return NotImplemented
    sys.exit(installer(args[0], args[1] if len(args) > 1 else "main"))

def verbe_courtier(args, prive=False):                                # n'interrompt jamais une demande en cours
    if args[:1] != ["redemarrer"]: return NotImplemented
    sys.exit(redemarrer(_opt(args, "--controle"), int(_opt(args, "--essai") or 1)))

def verbe_agent(args, prive=False):
    if args[:1] == ["apercu"] and len(args) == 3: sys.exit(agent_apercu(args[1], args[2]))
    elif args[:1] == ["appliquer"] and len(args) == 3: print(agent_appliquer(args[1], args[2]))
    else: return NotImplemented

def verbe_args(args, prive=False):                                    # pour un autre accès (ex. pont Telegram) : mêmes réglages qu'Herdr
    exiger_bac_a_sable(args[0])
    # moteur non admis : refusé (l'accès choisit l'autre) ; --contrat : tests/contrat-moteur.sh, qui JOUE l'admission
    pb = None if ouvert(args[0]) or "--contrat" in args else moteurs.moteur_admis(args[1], args[0])
    if pb: sys.exit(f"{conf(args[0])['nom']} : {pb}")
    print(json.dumps({"cwd": str(travail(args[0])), "args": moteurs.args_moteur(args[0], args[1], "--non-interactif" not in args),
                      "env": {"BERGER_AGENT": args[0], "BERGER_DIR": str(BERGER), **env_tmp(args[0], args[1]),
                              **({"CODEX_HOME": str(CODEX_HOME)} if args[1] == "codex" else {})}}))


