def il_y_a(quand):
    if not quand: return PALE + "jamais" + R
    j = (datetime.datetime.now() - quand).days
    return "aujourd'hui" if j == 0 else "hier" if j == 1 else f"il y a {j} j" if j < 31 else JAUNE + f"il y a {j} j" + R


def cartes_tableau():
    """Les cartes du Tableau en texte de panneau : (colonne, titre, lignes, vif), depuis cartes_donnees()."""
    return [(x["colonne"], x["titre"], [ligne_texte(l) for l in x["lignes"]], x["vif"]) for x in cartes_donnees()]


COLONNES_TABLEAU = tuple((cle, lib, TONS[ton]) for cle, lib, ton in COLONNES_TONS)


def empreinte(a):
    """Ce qui peut changer l'affichage : dates de modification des fichiers suivis (sans lire leur contenu)."""
    racines = [dossier(x) for x in agents()] if a is None else [dossier(a)]
    vu = []
    for d in racines:
        for sous in ("", "memory", "pending", "heartbeat", "historique", "taches", "skills-agent"):
            try:
                with os.scandir(d / sous) as it: vu += [(e.path, e.stat().st_mtime_ns) for e in it if e.is_file()]
            except OSError: pass
        for x in (d / "sorties").glob("*"): vu.append((str(x), x.stat().st_mtime_ns))
    vu.append(("test", (BERGER / "tests/dernier-resultat.txt").stat().st_mtime_ns if (BERGER / "tests/dernier-resultat.txt").exists() else 0))
    vu.append(("codex", (CODEX_HOME / "config.toml").stat().st_mtime_ns if (CODEX_HOME / "config.toml").exists() else 0))
    v = BERGER / "courtier/validations"
    vu.append(("validations", tuple(sorted((x.name, x.stat().st_mtime_ns) for x in v.iterdir())) if v.is_dir() else ()))
    suivis = [BERGER / "equipes" / p_ / "demandes" for p_ in EQUIPES] + [AGENTS / x / "a-lire" for x in agents()] + [BERGER / "a-lire", RESULTATS, dossier_checklists()]
    for x in agents() if a is None else []:                              # Décisions : la conversation notée de chaque agent
        cid = lire(dossier(x) / ".conversation-claude").strip()
        f = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", str(travail(x))) / f"{cid}.jsonl"
        if cid and f.is_file(): vu.append((str(f), f.stat().st_mtime_ns))
    for d in suivis:                                                     # Tableau / Accueil : fusions et documents à lire
        try:
            with os.scandir(d) as it: vu += [(e.path, e.stat().st_mtime_ns) for e in it if e.is_file()]
        except OSError: pass
    vu.append(("lectures", LECTURES.stat().st_mtime_ns if LECTURES.exists() else 0))
    for nom in ("appels.log", "echanges.jsonl", "dernier-audit.txt", "derniere-sauvegarde.txt"):
        vu.append((nom, (BERGER / "courtier" / nom).stat().st_mtime_ns if (BERGER / "courtier" / nom).exists() else 0))
    return hash(tuple(sorted(vu)))


def aplatir(lignes):
    return [x for l in lignes for x in str(l).split("\n")]


def fenetre(lignes, decalage, h):
    """Ce qu'on voit d'un contenu plus long que le pane : h - 2 lignes à partir de `decalage` (borné), puis une ligne
    « ↑↓ lignes a–b sur n ». Un contenu qui tient dans le pane est rendu tel quel. Rend (lignes visibles, décalage borné)."""
    plates = aplatir(lignes); place = max(1, h - 1)
    if len(plates) <= place: return plates, 0
    utile = place - 1
    if utile < 1: return plates[:place], 0                                   # pane d'une ou deux lignes : pas de pied
    decalage = max(0, min(decalage, len(plates) - utile))
    pied = PALE + f"  ↑↓ molette · lignes {decalage + 1}–{decalage + utile} sur {len(plates)}" + R
    return plates[decalage:decalage + utile] + [pied], decalage


def lignes_molette():
    """Lignes par cran de molette = le réglage de Herdr lui-même (ui.mouse_scroll_lines, 3 par défaut). Dans l'écran séparé,
    Herdr envoie UNE flèche par cran sans appliquer ce réglage (src/server/pane_input.rs, WheelRouting::AlternateScroll) :
    le panneau l'applique, pour défiler comme un pane ordinaire."""
    f = Path(os.environ.get("HERDR_CONFIG_PATH") or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "herdr/config.toml")
    try: ui = tomllib.loads(f.read_text()).get("ui", {})
    except Exception: return 3                                              # absente ou illisible : le défaut de Herdr
    n = ui.get("mouse_scroll_lines", 3) if isinstance(ui, dict) else 3
    return n if type(n) is int and n >= 1 else 3                            # Herdr refuse 0, un décimal, un booléen


def touches(octets, page, pas=3):
    """Déplacement demandé par ce qui a été reçu au clavier : molette ou flèches (pas lignes), Page Haut / Page Bas (une page),
    Début / Fin. Rend un nombre de lignes (négatif = vers le haut), ou None pour « tout en haut » / float('inf') pour « en bas »."""
    if b"\x1b[H" in octets or b"\x1b[1~" in octets or b"\x1bOH" in octets: return None
    if b"\x1b[F" in octets or b"\x1b[4~" in octets or b"\x1bOF" in octets: return float("inf")
    bas = octets.count(b"\x1b[B") + octets.count(b"\x1bOB"); haut = octets.count(b"\x1b[A") + octets.count(b"\x1bOA")
    return pas * (bas - haut) + page * (octets.count(b"\x1b[6~") - octets.count(b"\x1b[5~"))


def cadre(lignes, w, h):
    """Un écran de panneau EXACTEMENT à la taille du pane : une ligne avec un retour à la ligne devient plusieurs lignes,
    chaque ligne est coupée à w colonnes visibles, h - 1 lignes au plus (jamais de débordement, donc jamais d'historique)."""
    plates = aplatir(lignes)
    return "\033[H" + "".join(couper(l, w) + "\033[K\n" for l in plates[:h - 1]) + "\033[J"


ECRAN_PANNEAU, ECRAN_NORMAL = "\033[?1049h\033[2J\033[3J\033[H\033[?25l", "\033[?25h\033[?1049l"   # écran séparé, sans historique


def panneau(type_, a=None, cadence=2):
    """Redessine SEULEMENT quand quelque chose change : un fichier de l'agent, un statut Herdr (relu toutes les
    15 s), la taille du panneau ou la minute de l'horloge. Entre deux, il ne fait que regarder des dates de fichiers."""
    vue = {"ensemble": "accueil", "source": "sources"}.get(type_, type_)   # anciens noms gardés (espaces et .herdr.json existants)
    if vue not in VUES: sys.exit(f"vue inconnue : {type_}" + (f" (écartée : {VUES_REFUSEES[vue]})" if vue in VUES_REFUSEES else f" — vues : {', '.join(sorted(VUES))}"))
    if vue == "alire": return lire_interactif()                           # onglet interactif (liste + lecture)
    import atexit, signal, termios
    sys.stdout.write(ECRAN_PANNEAU); sys.stdout.flush()                   # écran séparé : la molette ne remonte plus d'anciens écrans
    clavier = None
    if sys.stdin.isatty():   # le panneau ne lit rien : sans écho, la molette (traduite en flèches dans l'écran séparé) ne s'affiche pas
        clavier = termios.tcgetattr(sys.stdin); muet = termios.tcgetattr(sys.stdin)
        muet[3] &= ~(termios.ECHO | termios.ICANON); termios.tcsetattr(sys.stdin, termios.TCSANOW, muet)
    def rendre():
        if clavier: termios.tcsetattr(sys.stdin, termios.TCSANOW, clavier)
        sys.stdout.write(ECRAN_NORMAL); sys.stdout.flush()
    atexit.register(rendre)
    for sig in (signal.SIGTERM, signal.SIGHUP): signal.signal(sig, lambda *_: sys.exit(0))
    mon_pane = os.environ.get("HERDR_PANE_ID"); dernier_controle = time.time(); avant = None; lignes = []; decalage = 0; pas = lignes_molette(); ecoute = True
    import select
    while True:
        # Un onglet fermé ne tue pas ses programmes (constaté le 04/10 : 5 copies de chaque panneau) :
        # le panneau vérifie lui-même, toutes les 30 s, que son pane existe encore, et s'arrête sinon.
        if mon_pane and time.time() - dernier_controle > 30:
            dernier_controle = time.time()
            if not herdr("pane", "get", mon_pane).get("pane"): return
        taille = tuple(_sh.get_terminal_size((100, 40))); w, h = taille; w = max(40, w - 1)
        try:
            cible = None if type_ in ("missions", "source", "checklists") else a   # missions : TOUS les agents ; source/checklists : `a` = un filtre
            statuts = tuple(statut_herdr(p) for x in ([cible] if cible else agents()) for p in herdr_ids(x).get("agents", {}).values())
            cle = (empreinte(cible), statuts, w, h, datetime.datetime.now().strftime("%H:%M"))
        except Exception as e:
            cle = ("erreur", str(e), w, h)
        if cle != avant:
            avant = cle
            try:
                lignes = VUES[vue].rendre(w, h, a)
                if vue == "tableau": mettre_a_jour_titres(a)
            except Exception as e:
                lignes = [ROUGE + f"erreur : {e}" + R]
            # Réécrit en place, ligne par ligne (pas d'effacement complet : pas de clignotement).
            visibles, decalage = fenetre(lignes, decalage, h)
            sys.stdout.write(cadre(visibles, w, h)); sys.stdout.flush()
        if not (clavier and ecoute): time.sleep(cadence); continue
        fin_attente = time.time() + cadence                                 # attendre le prochain tour… ou la molette
        while (reste := fin_attente - time.time()) > 0:
            if not select.select([sys.stdin], [], [], reste)[0]: break
            try: octets = os.read(sys.stdin.fileno(), 4096)
            except OSError: return                                          # terminal raccroché : arrêt propre
            if not octets: ecoute = False; break                            # plus d'entrée : on ne l'écoute plus
            if tuple(_sh.get_terminal_size((100, 40))) != taille: break     # pane redimensionné : vrai tour à la nouvelle taille
            d = touches(octets, max(1, h - 3), pas)
            nouveau = 0 if d is None else (10 ** 9 if d == float("inf") else decalage + d)
            visibles, nouveau = fenetre(lignes, nouveau, h)
            if nouveau != decalage:
                decalage = nouveau; sys.stdout.write(cadre(visibles, w, h)); sys.stdout.flush()


# ───────────────────────────── espaces Herdr ─────────────────────────────

ICONES_ONGLETS = {"Travail": "💼", "Fiche": "📇", "Missions": "🎯", "Équipe": "👥"}   # un caractère chacun : rien ne se décale ;
                                                                                    # les onglets des vues s'y ajoutent (charger_vues)


def onglet(nom):
    """Libellé affiché d'un onglet : son icône puis son nom (« 🏠 Accueil »)."""
    return f"{ICONES_ONGLETS[nom]} {nom}" if nom in ICONES_ONGLETS else nom


def nom_onglet(libelle):
    """Nom d'un onglet sans son icône : retrouve « Accueil » sous « 🏠 Accueil » comme sous « Accueil » (onglets d'avant)."""
    tete, _, reste = (libelle or "").partition(" ")
    return reste if tete in ICONES_ONGLETS.values() and reste else (libelle or "")


ONGLETS_BERGER = ()   # (libellé, type) après l'Accueil : rempli par charger_vues() d'après ONGLET/ORDRE des vues


def deplacements(noms):
    """Les tab.move qui rangent les onglets connus dans l'ordre Accueil + ONGLETS_BERGER, en tête ; un onglet inconnu
    garde sa place relative, après eux. → [(nom, insert_index)], à jouer dans l'ordre (chacun vers la gauche)."""
    ordre = ["Accueil"] + [l for l, _ in ONGLETS_BERGER]
    voulu = [n for n in ordre if n in noms] + [n for n in noms if n not in ordre]
    cours = list(noms); out = []
    for k, n in enumerate(voulu):
        i = cours.index(n)
        if i != k: out.append((n, k)); cours.insert(k, cours.pop(i))
    return out


def ranger_onglets(ws):
    """Remet les onglets de l'espace Berger dans l'ordre (un onglet ajouté après coup arrive en fin de liste) par tab.move,
    méthode de l'API Herdr (la ligne de commande 0.9.3 ne l'a pas). Rend les noms déplacés."""
    faits = []
    for n, k in deplacements([nom_onglet(t.get("label")) for t in herdr("tab", "list", "--workspace", ws).get("tabs", [])]):
        t = next((t for t in herdr("tab", "list", "--workspace", ws).get("tabs", []) if nom_onglet(t.get("label")) == n), None)
        if t and herdr_api("tab.move", {"tab_id": t["tab_id"], "insert_index": k}): faits.append(n)
    return faits


def onglet_panneau(ws, label, type_):
    """Ajoute à l'espace ws un onglet qui affiche le panneau type_ (berger panneau <type_>)."""
    t = herdr("tab", "create", "--workspace", ws, "--cwd", str(BERGER), "--label", onglet(label), "--no-focus")
    p = (t.get("root_pane") or t.get("pane") or {}).get("pane_id") or next(
        x["pane_id"] for x in herdr("pane", "list", "--workspace", ws)["panes"] if x["tab_id"] == t["tab"]["tab_id"])
    herdr("pane", "run", p, f"clear; {BERGER / 'bin/berger'} panneau {type_}")


def espace(cible):
    moi = str(BERGER / "bin/berger")
    if cible == "ensemble":
        r = herdr("workspace", "create", "--no-focus", "--cwd", str(BERGER), "--label", ESPACE_BERGER)
        herdr("tab", "rename", r["tab"]["tab_id"], onglet("Accueil"))
        herdr("pane", "run", r["root_pane"]["pane_id"], f"clear; {moi} panneau accueil")
        for label, type_ in ONGLETS_BERGER: onglet_panneau(r["workspace"]["workspace_id"], label, type_)
        print(f"espace Berger : {r['workspace']['workspace_id']}"); return
    a = cible; d = travail(a); c = conf(a)
    r = herdr("workspace", "create", "--no-focus", "--cwd", str(d), "--label", f"{c['icone']} {c['nom']}",
              "--env", f"CODEX_HOME={CODEX_HOME}", "--env", f"BERGER_AGENT={a}", "--env", f"BERGER_DIR={BERGER}")
    ws = r["workspace"]["workspace_id"]; ancien = herdr_ids(a)
    ids = {"workspace": ws, "agents": {}, "panneaux": {}}
    herdr("tab", "rename", r["tab"]["tab_id"], onglet("Travail"))
    panes = [r["root_pane"]["pane_id"]]
    moteurs = moteurs_espace(a)
    if hote_mission(a) and agent_vivant(a):                                # il travaille déjà dans l'onglet Missions d'un autre
        ids["agents"], ids["mission"] = ancien["agents"], ancien["mission"]
        herdr("tab", "rename", r["tab"]["tab_id"], "Mission")
        herdr("pane", "run", panes[0], f"clear; {moi} panneau journal {a}"); moteurs = []; ids["panneaux"]["journal"] = panes[0]
    for _ in moteurs[1:]:
        panes.append(herdr("pane", "split", "--pane", panes[-1], "--direction", "right", "--cwd", str(d), "--no-focus")["pane"]["pane_id"])
    for m, p in zip(moteurs, panes):
        ids["agents"][demarrer_agent(a, m, p) or m] = p
    ids["panneaux"].update(colonne_travail(a, panes[-1]))                  # à droite : en cours, puis le domaine
    ids["panneaux"].update(onglet_fiche(ws, a)); ids["panneaux"].update(onglets_agent(ws, a))
    (dossier(a) / ".herdr.json").write_text(json.dumps(ids, indent=2) + "\n")
    message_remettre(a)                                                    # messages reçus pendant son sommeil (sinon : planificateur)
    print(f"espace {c['nom']} : {ws} — {ids}")


def moteurs_espace(a):
    """Moteurs de l'onglet Travail : ceux de `panneaux` (agent.conf), ou le seul moteur choisi pour la mission en cours."""
    if reglages_mission(a)[0]: return [reglages_mission(a)[0]]            # mission : le moteur choisi par celui qui la confie
    return [m.strip() for m in conf(a)["panneaux"].split(",") if m.strip()]


def domaine_travail(a):
    """Panneaux du métier sous « en cours » : [(clé, commande)] — [espaces.<a>].a_cote, sinon le `domaine` d'agent.conf."""
    if espace_conf(a) is not None:                                         # espace.toml / [espaces.<agent>] : les panneaux de SON rôle
        return [(f"cote-{i + 1}", commande_element(a, el)) for i, el in enumerate(elements_cote(a))]
    return [(f"domaine-{i + 1}", x.strip()) for i, x in enumerate(
        [x for x in conf(a).get("domaine", "").split("|") if x.strip() and "etat-taches" not in x][:2])]   # la liste est déjà dans « en cours »


def colonne_travail(a, base):
    """Onglet Travail (maquette A) : à droite de l'agent, le panneau « en cours », puis au plus 2 panneaux de domaine
    (domaine = cmd1 | cmd2 …) empilés dessous. Moins de panneaux, plus grands."""
    d = travail(a); moi = str(BERGER / "bin/berger"); ids = {}
    p = herdr("pane", "split", "--pane", base, "--direction", "right", "--ratio", "0.58", "--cwd", str(d), "--no-focus")["pane"]["pane_id"]
    herdr("pane", "rename", p, "en cours"); herdr("pane", "run", p, f"clear; {moi} panneau encours {a}"); ids["encours"] = p
    domaine = domaine_travail(a)
    bas = p
    for i, (cle, cmd) in enumerate(domaine):
        # ratio = part GARDÉE par le pane coupé (skill herdr) : « en cours » garde 55 % (40 % s'il y a 2-3 panneaux),
        # puis chaque panneau garde 1/(restants + 1) : parts égales sous « en cours »
        part = ("0.55" if len(domaine) == 1 else "0.40") if i == 0 else f"{1 / (len(domaine) - i + 1):.2f}"
        q = herdr("pane", "split", "--pane", bas, "--direction", "down", "--ratio", part, "--cwd", str(d), "--no-focus")["pane"]["pane_id"]
        herdr("pane", "run", q, f"clear; {cmd}"); ids[cle] = q; bas = q
    return ids


def onglets_agent(ws, a):
    """Les onglets propres au rôle de l'agent ([espaces.<agent>].onglets) : 1 à 4 panneaux chacun (côte à côte, puis en grille)."""
    ids = {}
    for lab, els in onglets_agent_conf(a): ids.update(onglet_role(ws, a, lab, els))
    return ids


def onglet_role(ws, a, lab, els):
    """Un onglet du rôle : 1 à 4 panneaux (côte à côte, puis en grille) → {onglet-<lab>-<i>: pane}."""
    d = travail(a); ids = {}
    t = herdr("tab", "create", "--workspace", ws, "--cwd", str(d), "--label", onglet(lab), "--no-focus")
    p0 = pane_racine(ws, t)
    panes = [p0]
    if len(els) >= 2: panes.append(herdr("pane", "split", "--pane", p0, "--direction", "right", "--cwd", str(d), "--no-focus")["pane"]["pane_id"])
    if len(els) >= 3: panes.append(herdr("pane", "split", "--pane", panes[1], "--direction", "down", "--cwd", str(d), "--no-focus")["pane"]["pane_id"])
    if len(els) >= 4: panes.append(herdr("pane", "split", "--pane", p0, "--direction", "down", "--cwd", str(d), "--no-focus")["pane"]["pane_id"])
    for i, (el, p) in enumerate(zip(els, panes)):
        herdr("pane", "run", p, f"clear; {commande_element(a, el)}"); ids[f"onglet-{lab}-{i + 1}"] = p
    return ids


def refaire_espace(a):
    """Passe un espace EXISTANT à la mise en page A SANS redémarrer l'agent : onglets Tableau, Journal et l'ancienne
    Fiche fermés, panneaux de domaine refaits à droite, Fiche d'une seule page. Les onglets Missions/Équipe restent."""
    if a == "berger":                                                       # espace Berger : Ensemble → Accueil
        ws = next((w["workspace_id"] for w in herdr("workspace", "list")["workspaces"] if w.get("label") in (ESPACE_BERGER, "Berger")), None)   # « Berger » : espace créé avant icone_berger
        if not ws: sys.exit("pas d'espace Berger : berger espace ensemble")
        t = next((t for t in herdr("tab", "list", "--workspace", ws)["tabs"] if nom_onglet(t.get("label")) in ("Ensemble", "Accueil")), None)
        herdr("tab", "rename", t["tab_id"], onglet("Accueil"))
        onglets_ = herdr("tab", "list", "--workspace", ws)["tabs"]
        # Panneaux déjà ouverts : relancés pour prendre le code à jour (un processus garde l'ancien code). Onglet inconnu : intact.
        noms = {x["tab_id"]: nom_onglet(x.get("label")) for x in onglets_}
        relances = [x for x in herdr("pane", "list", "--workspace", ws)["panes"] if commande_onglet_berger(noms.get(x["tab_id"]))]
        for x in relances: herdr("pane", "send-keys", x["pane_id"], "ctrl+c")
        if relances: time.sleep(1)
        for x in relances: herdr("pane", "run", x["pane_id"], f"clear; {commande_onglet_berger(noms[x['tab_id']])}")
        for x in onglets_:                                                  # onglets d'avant les icônes : renommés
            if x.get("label") != onglet(nom_onglet(x.get("label"))): herdr("tab", "rename", x["tab_id"], onglet(nom_onglet(x.get("label"))))
        presents = {nom_onglet(x.get("label")) for x in onglets_}
        ajoutes = [l for l, _ in ONGLETS_BERGER if l not in presents]                  # onglets venus après la création de l'espace
        for l, ty in ONGLETS_BERGER:
            if l in ajoutes: onglet_panneau(ws, l, ty)
        ranges = ranger_onglets(ws)
        return (f"espace Berger : onglet Accueil ; {len(relances)} panneau(x) relancé(s)" + (f" ; ajouté(s) : {', '.join(ajoutes)}" if ajoutes else "")
                + (f" ; remis en ordre : {', '.join(ranges)}" if ranges else ""))
    ids = herdr_ids(a); ws = ids.get("workspace")
    if not espace_ouvert(a): sys.exit(f"{conf(a)['nom']} n'a pas d'espace ouvert : berger espace {a}")
    agents_p = set(ids.get("agents", {}).values())
    onglet_agent = next((x["tab_id"] for x in herdr("pane", "list", "--workspace", ws)["panes"] if x["pane_id"] in agents_p), None)
    garder = {t["tab_id"] for t in herdr("tab", "list", "--workspace", ws)["tabs"] if nom_onglet(t.get("label")) in ("Missions", "Équipe")}
    for t in herdr("tab", "list", "--workspace", ws)["tabs"]:
        if t["tab_id"] not in garder and t["tab_id"] != onglet_agent: herdr("tab", "close", t["tab_id"])
    for x in herdr("pane", "list", "--workspace", ws)["panes"]:            # dans l'onglet de l'agent : tout sauf l'agent
        if x["tab_id"] == onglet_agent and x["pane_id"] not in agents_p: herdr("pane", "close", x["pane_id"])
    herdr("tab", "rename", onglet_agent, onglet("Travail"))
    for t in herdr("tab", "list", "--workspace", ws)["tabs"]:                  # Missions / Équipe gardés : icône ajoutée
        if t["tab_id"] in garder and t.get("label") != onglet(nom_onglet(t.get("label"))): herdr("tab", "rename", t["tab_id"], onglet(nom_onglet(t.get("label"))))
    base = list(ids["agents"].values())[-1]
    ids["panneaux"] = colonne_travail(a, base); ids["panneaux"].update(onglet_fiche(ws, a)); ids["panneaux"].update(onglets_agent(ws, a))
    ecrire_ids(a, ids)
    return f"espace de {conf(a)['nom']} : Travail (agent | en cours + domaine) · Fiche" + "".join(f" · {lab}" for lab, _ in onglets_agent_conf(a))


def onglet_fiche(ws, a):
    """Onglet Fiche = UNE page lisible (06/10/2026 : remplace la grille de 6 petits panneaux, jugée illisible)."""
    d = travail(a); moi = str(BERGER / "bin/berger")
    t = herdr("tab", "create", "--workspace", ws, "--cwd", str(d), "--label", onglet("Fiche"), "--no-focus")
    p0 = pane_racine(ws, t)
    herdr("pane", "run", p0, f"clear; {moi} panneau fiche {a}"); return {"fiche": p0}


# ─── L'espace VOULU d'un agent (spec docs/plans/2026-10-15-regles-espace-spec.md) : ce que les règles fixes R1…R7 demandent,
# calculé depuis les seuls fichiers (agent.conf, config.toml, MISSION.md, .herdr.json, historique/) — jamais Herdr.
# Il ne change rien : conformer_espace() (plus bas) s'en sert pour ajouter et fermer. ───
REGLES_ESPACE = {
    "R1": "Travail : la conversation (un panneau par moteur, ou le moteur de la mission), « en cours », puis les panneaux du métier",
    "R2": "Mission ailleurs : en mission dans l'onglet Missions d'un hôte, l'onglet Travail devient « Mission » et montre le journal",
    "R3": "Fiche : une page",
    "R4": "Onglets du rôle : [espaces.<agent>].onglets, dans l'ordre, 4 panneaux au plus",
    "R5": "Missions : au moins un agent en mission chez lui — le suivi, puis la conversation de chacun",
    "R6": "Équipe : chef de projet — le même onglet, voulu s'il héberge un agent ou si un développeur de son équipe est ouvert",
    "R7": "Délai : un onglet Missions/Équipe sans objet reste voulu 24 h (date de fin connue), puis plus du tout",
}
DELAI_SANS_OBJET = datetime.timedelta(hours=24)


def _date_minute(d):
    return d.strftime("%Y-%m-%dT%H:%M") if d else None


def debut_mission(a):
    """Début de la mission en cours de `a` : l'en-tête de MISSION.md, sinon la date du fichier ; None sans mission."""
    f = dossier(a) / "MISSION.md"
    if not f.is_file(): return None
    r = re.search(r"^# Mission confiée par .* — (\d{4}-\d{2}-\d{2} \d{2}:\d{2})", lire(f), re.M)
    try: return datetime.datetime.strptime(r.group(1), "%Y-%m-%d %H:%M") if r else datetime.datetime.fromtimestamp(f.stat().st_mtime)
    except (ValueError, OSError): return None


def _date_dans_nom(nom):
    r = re.search(r"(\d{4}-\d{2}-\d{2})_(\d{2})(\d{2})", nom)
    try: return datetime.datetime.strptime(f"{r.group(1)} {r.group(2)}:{r.group(3)}", "%Y-%m-%d %H:%M") if r else None
    except ValueError: return None


def fin_derniere_mission(a):
    """Fin de la dernière mission rangée de `a` (historique/mission-AAAA-MM-JJ_HHMM.md) ; None si inconnue."""
    if a not in agents(): return None
    return max((d for f in (dossier(a) / "historique").glob("mission-*.md") if (d := _date_dans_nom(f.name))), default=None)


def developpeurs_ouverts(chef):
    """Développeurs ouverts des équipes dont `chef` est le chef de projet (agent.conf : projet et sujet)."""
    projets = {p for p, e in EQUIPES.items() if e.get("chef_projet") == chef}
    return [x for x in agents() if x != chef and conf(x).get("projet") in projets and conf(x).get("sujet")]


def espace_voulu(a, maintenant=None):
    """L'espace que les règles R1…R7 veulent pour `a` : onglets dans l'ordre, panneaux, règle et raison de chacun. Fonction
    pure : ne lit que des fichiers, n'appelle pas Herdr, n'écrit rien. Pour un agent sans besoin nouveau, c'est exactement
    l'espace que construit espace() (tests/regles-espace.py)."""
    c = conf(a); moi = str(BERGER / "bin/berger"); maintenant = maintenant or datetime.datetime.now()
    ids = herdr_ids(a); hote = hote_mission(a)
    onglets_, ecartes = [], []
    pan = lambda cle, cmd, regle, raison: {"cle": cle, "genre": "panneau", "commande": cmd, "agent": None, "moteur": None,
                                            "protege": False, "regle": regle, "raison": raison}
    conv = lambda cle, x, m, regle, raison: {"cle": cle, "genre": "agent", "commande": None, "agent": x, "moteur": m,
                                             "protege": True, "regle": regle, "raison": raison}
    ong = lambda cle, lib, regle, raison, panneaux, cond=None, depuis=None: {
        "cle": cle, "libelle": lib, "regle": regle, "raison": raison, "conditionnel": cond is not None,
        "condition": cond, "depuis": _date_minute(depuis), "panneaux": panneaux}
    # R1 / R2 — Travail (ou « Mission » quand sa conversation vit chez un hôte)
    ailleurs = bool(hote and ids.get("agents"))
    if ailleurs:
        tete = [pan("journal", f"{moi} panneau journal {a}", "R2", f"sa conversation vit dans l'onglet Missions de {hote} : ici, son journal")]
    else:
        mm = reglages_mission(a)[0]
        tete = [conv(f"agent-{m}", a, m, "R1", f"moteur {m} " + ("choisi pour sa mission (MISSION.md)" if mm else "de « panneaux » (agent.conf)"))
                for m in moteurs_espace(a)]
    metier = source_espace(a, "a_cote") if espace_conf(a) is not None else "« domaine » d'agent.conf"
    travail_ = tete + [pan("encours", f"{moi} panneau encours {a}", "R1", "ce qu'il fait : checklist, à faire, validations")] + [
        pan(k, cmd, "R1", f"panneau du métier ({metier})") for k, cmd in domaine_travail(a)]
    if ailleurs:
        onglets_.append(ong("travail", "Mission", "R2", f"en mission chez {hote}", travail_, True, debut_mission(a)))
    else:
        onglets_.append(ong("travail", onglet("Travail"), "R1", "toujours : l'agent et ce qu'il fait", travail_))
    # R3 — Fiche
    onglets_.append(ong("fiche", onglet("Fiche"), "R3", "toujours : qui il est, une page",
                        [pan("fiche", f"{moi} panneau fiche {a}", "R3", "sa fiche")]))
    # R4 — onglets de son rôle
    for lab, els in onglets_agent_conf(a):
        onglets_.append(ong(f"onglet-{lab}", onglet(lab), "R4", f"déclaré dans {source_espace(a, 'onglets')}",
                            [pan(f"onglet-{lab}-{i + 1}", commande_element(a, el), "R4", f"élément « {el} »") for i, el in enumerate(els)]))
    # R5 / R6 / R7 — Missions (Équipe chez un chef de projet)
    heberges = [x for x in agents() if x != a and hote_mission(x) == a]
    chef = a in chefs()
    devs = developpeurs_ouverts(a) if chef else []
    objet = sorted(set(heberges) | set(devs))
    regle, lib = ("R6", "Équipe") if chef else ("R5", "Missions")
    if objet:
        debuts = [d for x in objet if (d := debut_mission(x) or (datetime.datetime.fromtimestamp((dossier(x) / "agent.conf").stat().st_mtime) if x in devs else None))]
        depuis = min(debuts, default=None)
        quoi = (f"en mission chez lui : {', '.join(heberges)}" if heberges else "") + ("" if not devs else
                (" ; " if heberges else "") + f"développeurs ouverts : {', '.join(devs)}")
    else:                                                                  # sans objet : depuis quand ? (dates connues seulement)
        residus = [x for x in (ids.get("missions") or {}).get("agents", {}) if x not in heberges]
        fins = [d for x in residus if (d := fin_derniere_mission(x))]
        if chef:
            fins += [d for f in (dossier(a) / "historique" / "equipe").glob("*") if (d := _date_dans_nom(f.name))]
        depuis = max(fins, default=None)
        quoi = "plus aucun agent en mission chez lui" + (" ni développeur ouvert" if chef else "")
    suivi_ = pan("mission-suivi", f"{moi} panneau missions {a}", regle, "le suivi de ses missions")
    panneaux_m = [suivi_] + [conv(f"mission-{x}", x, next(iter(herdr_ids(x).get("agents", {})), None) or reglages_mission(x)[0] or conf(x)["moteur"],
                                  regle, f"{x} est en mission chez lui (sa conversation : jamais fermée)") for x in heberges]
    if objet:
        onglets_.append(ong("missions", onglet(lib), regle, quoi, panneaux_m, True, depuis))
    elif depuis and maintenant - depuis < DELAI_SANS_OBJET:
        onglets_.append(ong("missions", onglet(lib), "R7", f"{quoi} depuis le {depuis:%d/%m %H:%M} : gardé 24 h", panneaux_m, False, depuis))
    elif depuis or chef or ids.get("missions"):
        ecartes.append({"cle": "missions", "libelle": onglet(lib), "regle": "R7" if depuis else regle, "depuis": _date_minute(depuis),
                        "raison": f"{quoi} depuis le {depuis:%d/%m %H:%M} (plus de 24 h)" if depuis else f"{quoi} (date inconnue)"})
    return {"agent": a, "nom": c["nom"], "heberge_par": hote, "onglets": onglets_, "ecartes": ecartes,
            "regles": [{"code": k, "texte": v} for k, v in REGLES_ESPACE.items()]}


def espace_voulu_texte(d):
    """Texte de « berger espace-voulu <agent> » : ne lit que les données (espace_voulu)."""
    out = [f"Espace voulu de {d['nom']} ({d['agent']})" + (f" — en mission chez {d['heberge_par']}" if d["heberge_par"] else "")]
    for o in d["onglets"]:
        cond = "" if not o["conditionnel"] else (" [condition vraie" if o["condition"] else " [condition fausse") + (f" depuis {o['depuis']}]" if o["depuis"] else "]")
        out.append(f"\n{o['libelle']}  ({o['regle']} : {o['raison']}){cond}")
        for p in o["panneaux"]:
            quoi = f"conversation {p['agent']} ({p['moteur']}) — protégée" if p["genre"] == "agent" else p["commande"]
            out.append(f"  · {p['cle']:<16} {quoi}\n    {'':<16} {p['regle']} : {p['raison']}")
    for e in d["ecartes"]:
        out.append(f"\nnon voulu : {e['libelle']}  ({e['regle']} : {e['raison']})")
    out.append("\nRègles : " + " · ".join(f"{r['code']} {r['texte']}" for r in d["regles"]))
    return "\n".join(out)


# ─── Espace auto (spec docs/plans/2026-10-15-espace-auto-spec.md) : à chaque passage du planificateur, au plus une fois toutes
# les 5 min par espace, l'espace RÉEL (Herdr) d'un agent est mis en conformité avec espace_voulu() : ce qui manque est ajouté,
# ce qui n'est plus voulu est fermé, chaque geste noté au journal de l'agent. Jamais une conversation (ni ouverte, ni fermée,
# ni relancée), jamais un onglet inconnu, jamais un agent qui attend une permission ; [espaces] auto = false arrête tout. ───
ESPACE_AUTO = (CONFIG.get("espaces") or {}).get("auto", True) is not False
CADENCE_ESPACE = datetime.timedelta(minutes=5)
PASSES_ESPACE = BERGER / ".espace-auto.json"                               # {agent: date de sa dernière passe}


def conformer_espaces(maintenant=None):
    """Passage du planificateur : chaque espace d'agent OUVERT, au plus une passe toutes les 5 min. → {agent: [gestes]}."""
    if not ESPACE_AUTO: return {}
    maintenant = maintenant or datetime.datetime.now(); passes = json_ou_rien(PASSES_ESPACE) or {}; faits = {}
    for a in agents():
        ws = herdr_ids(a).get("workspace")
        if not ws or ws not in libelles_espaces(): continue                # pas d'espace ouvert (ex. en mission chez son chef)
        try: der = datetime.datetime.fromisoformat(str(passes.get(a)))
        except ValueError: der = None
        if der and maintenant - der < CADENCE_ESPACE: continue
        passes[a] = maintenant.isoformat(timespec="seconds")
        try: faits[a] = conformer_espace(a, maintenant)
        except Exception as e: print(f"espace auto {a} : {type(e).__name__} {e}", file=sys.stderr)   # un agent n'arrête pas les autres
    if faits: PASSES_ESPACE.write_text(json.dumps(passes, indent=1) + "\n")
    return faits


def conversations_herdr():
    """Panneaux qui portent la conversation d'un agent : ceux que Berger a enregistrés (.herdr.json › agents, missions) et
    ceux où Herdr voit un agent. Jamais fermés, jamais relancés."""
    p = {x.get("pane_id") for x in herdr("agent", "list").get("agents", [])}
    for x in agents():
        i = herdr_ids(x); p |= set((i.get("agents") or {}).values()) | set(((i.get("missions") or {}).get("agents") or {}).values())
    return p - {None}


def conformer_espace(a, maintenant=None):
    """Met l'espace OUVERT de `a` en conformité avec espace_voulu(a). → les gestes faits (chacun noté au journal de `a`)."""
    ids = herdr_ids(a); ws = ids.get("workspace"); d = travail(a)
    tabs = herdr("tab", "list", "--workspace", ws).get("tabs", []); panes = herdr("pane", "list", "--workspace", ws).get("panes", [])
    if not tabs or not panes: return []                                    # Herdr illisible : on ne devine rien
    convs = conversations_herdr()
    if any(statut_herdr(p, ttl=0) == "blocked" for p in convs & ({x["pane_id"] for x in panes} | set((ids.get("agents") or {}).values()))):
        return []                                                          # une conversation attend une permission : rien
    v = espace_voulu(a, maintenant)
    reg = dict(ids.get("panneaux") or {}); mis = dict(ids.get("missions") or {}); mis_avant = dict(mis)
    tab_de = {x["pane_id"]: x["tab_id"] for x in panes}
    dans = lambda t: [p for p, t_ in tab_de.items() if t_ == t]
    noms = {t["tab_id"]: nom_onglet(t.get("label")) for t in tabs}; labels = {t["tab_id"]: t.get("label") for t in tabs}
    gestes = []
    def geste(texte): gestes.append(texte); journal(a, f"espace auto : {texte}")

    # 1. Reconnaître les onglets réels : par ce que Berger y a enregistré, sinon par leur libellé. Le reste est INCONNU.
    connus = {}
    def poser(cle, candidats, libelles=()):
        t = next((t for t in candidats if t in noms and t not in connus.values()), None) or next(
            (t for t, n in noms.items() if n in libelles and t not in connus.values()), None)
        if t: connus[cle] = t
    poser("travail", [tab_de.get(p) for p in [*(ids.get("agents") or {}).values(), reg.get("encours"), reg.get("journal")]], ("Travail", "Mission"))
    poser("fiche", [tab_de.get(reg.get("fiche"))], ("Fiche",))
    roles = dict(onglets_agent_conf(a))
    for lab in dict.fromkeys([*roles, *(k[len("onglet-"):].rsplit("-", 1)[0] for k in reg if k.startswith("onglet-"))]):
        poser(f"onglet-{lab}", [tab_de.get(p) for k, p in reg.items() if k.rsplit("-", 1)[0] == f"onglet-{lab}"], (lab,) if lab in roles else ())
    poser("missions", [mis.get("tab"), tab_de.get(mis.get("suivi"))], ("Missions", "Équipe"))
    voulus = {o["cle"]: o for o in v["onglets"]}
    avec_conv = lambda t: any(p in convs for p in dans(t))
    def fermer_onglet(t, texte):
        herdr("tab", "close", t); geste(f"fermé l'onglet « {labels[t]} » ({texte})")
        for p in dans(t): tab_de.pop(p)

    # 2. Fermer ce qui n'est plus voulu : Missions/Équipe écarté avec une fin CONNUE de plus de 24 h ; onglet du rôle retiré.
    for e in v["ecartes"]:
        t = connus.get(e["cle"])
        if t and e["depuis"] and not avec_conv(t):                         # date inconnue : gardé ; une conversation : gardé
            fermer_onglet(t, f"{e['regle']} : {e['raison']}"); connus.pop(e["cle"]); mis = {}
    for cle, t in list(connus.items()):
        if cle.startswith("onglet-") and cle not in voulus and not avec_conv(t):
            fermer_onglet(t, f"plus déclaré dans {source_espace(a, 'onglets')}"); connus.pop(cle)
            reg = {k: p for k, p in reg.items() if k.rsplit("-", 1)[0] != cle}
    # … et un panneau enregistré par Berger que les règles ne veulent plus, dans un onglet connu (jamais seul dans son onglet)
    cles_voulues = {p["cle"] for o in v["onglets"] for p in o["panneaux"]}
    for k, p in list(reg.items()):
        if k in cles_voulues: continue
        t = tab_de.get(p)
        if t is None: reg.pop(k); continue                                 # panneau disparu : on l'oublie
        if t not in connus.values() or p in convs or len(dans(t)) < 2: continue
        if t == connus.get("travail") and not avec_conv(t): continue        # Travail sans conversation : rien n'y est fermé
        herdr("pane", "close", p); tab_de.pop(p); reg.pop(k); geste(f"fermé le panneau « {k} » (plus voulu par les règles)")

    # 3. Ajouter ce qui manque (jamais une conversation : un onglet Travail absent n'est pas recréé, `berger espace <agent>`)
    for cle, o in voulus.items():
        t = connus.get(cle)
        if t is None:
            if cle == "travail" or (o["conditionnel"] and not o["condition"]): continue   # sans objet : pas recréé pour être fermé
            if cle == "fiche": reg.update(onglet_fiche(ws, a))
            elif cle == "missions": mis = onglet_missions(a)
            else: reg.update(onglet_role(ws, a, cle[len("onglet-"):], roles[cle[len("onglet-"):]]))
            geste(f"ajouté l'onglet « {o['libelle']} » ({o['regle']} : {o['raison']})"); continue
        if labels[t] != o["libelle"]:
            herdr("tab", "rename", t, o["libelle"]); geste(f"onglet « {labels[t]} » renommé « {o['libelle']} » ({o['regle']})")
        ou = {"mission-suivi": mis.get("suivi")} | {p["cle"]: (ids.get("agents") or {}).get(p["moteur"]) if p["agent"] == a
                                                    else (mis.get("agents") or {}).get(p["agent"]) for p in o["panneaux"] if p["genre"] == "agent"}
        precedent = None
        for p in o["panneaux"]:
            k = p["cle"]; actuel = ou.get(k) if k in ou else reg.get(k)
            if tab_de.get(actuel) == t: precedent = actuel; continue
            if p["genre"] != "panneau": continue                           # une conversation absente n'est jamais démarrée ici
            if k in ("journal", "mission-suivi") and any(x not in convs and x not in reg.values() and x != mis.get("suivi") for x in dans(t)):
                continue                                                   # un panneau d'avant, non enregistré, tient déjà ce rôle
            base = precedent or dans(t)[-1]
            r = herdr("pane", "split", "--pane", base, "--direction", "right" if k == "encours" else "down",
                      *(["--ratio", "0.58"] if k == "encours" else []), "--cwd", str(d), "--no-focus")
            n = (r.get("pane") or {}).get("pane_id")
            if not n: continue
            if k == "encours": herdr("pane", "rename", n, "en cours")
            herdr("pane", "run", n, f"clear; {p['commande']}"); tab_de[n] = t; precedent = n
            if k == "mission-suivi": mis = {"agents": {}, **mis, "tab": t, "suivi": n}
            else: reg[k] = n
            geste(f"ajouté le panneau « {k} » dans « {o['libelle']} » ({p['regle']} : {p['raison']})")

    # 4. .herdr.json relu au dernier moment (une mission a pu s'ouvrir entre-temps) : seuls nos changements y sont portés
    if reg != (ids.get("panneaux") or {}) or mis != mis_avant:
        frais = herdr_ids(a); frais["panneaux"] = reg
        if mis != mis_avant:
            if mis: frais["missions"] = mis
            else: frais.pop("missions", None)
        ecrire_ids(a, frais)
    return gestes


# ───────────────────────────── audit des secrets ─────────────────────────────

# (le chemin du coffre vient de config.toml : COFFRE, en tête de fichier)


def valeurs_coffre():
    """{valeur SECRÈTE du coffre : nom de sa clé} — ce qu'aucun fichier hors du coffre ne doit contenir. Une valeur sous une
    clé « parlante » (mot de passe, jeton, clé…), assez longue, qui n'est ni un simple mot ni une URL ni un chemin."""
    parlant = re.compile(r"(?i)pass|pwd|mdp|motdepasse|secret|token|jeton|key|cle|clé|credential|auth|cookie|private|seed|pin")
    valeurs = {}

    def parcourir(x, chemin=""):
        if isinstance(x, dict): [parcourir(v, f"{chemin}.{k}" if chemin else k) for k, v in x.items()]
        elif isinstance(x, list): [parcourir(v, chemin) for v in x]
        elif isinstance(x, (str, int)) and len(str(x)) >= 8 and parlant.search(chemin.rsplit(".", 1)[-1]) \
                and not re.fullmatch(r"[a-z_ -]+|[A-Z_]+|https?://\S+|[~/][\w./-]*", str(x)):    # un simple mot (« client_credentials ») ou une URL n'est pas un secret
            valeurs[str(x)] = chemin                                      # (faux positif du 04/10 : une valeur du coffre faite de mots ordinaires : 205 faux positifs)
    try: parcourir(json.loads(COFFRE.read_text()))
    except (OSError, ValueError): pass
    return valeurs


def secrets_audit():
    """Cherche les valeurs SECRÈTES du coffre en clair ailleurs que dans le coffre : dossiers des agents, journal du
    courtier, sessions des moteurs (Codex de Berger, transcriptions Claude des agents), labo archivé.
    Recherche les valeurs du coffre dans les fichiers accessibles des zones auditées.
    N'affiche JAMAIS une valeur : seulement le fichier et le NOM de la clé."""
    valeurs = {v.encode(): c for v, c in valeurs_coffre().items()}
    projets = HOME / ".claude/projects"; cle_claude = str(BERGER).replace("/", "-")      # transcriptions Claude des agents
    zones = [BERGER] + sorted(projets.glob(cle_claude + "*")) + [Path(os.path.expanduser(z)) for z in CONFIG.get("audit_zones_en_plus", [])]
    # Agents qui travaillent dans un dossier existant : leurs transcriptions Claude sont rangées sous CE dossier.
    zones += [z for a in agents() if externe(a) for z in sorted(projets.glob(re.sub(r"[^A-Za-z0-9-]", "-", str(travail(a))) + "*"))]
    trouves, vus = {}, 0
    for z in zones:
        for f in (z.rglob("*") if z.is_dir() else []):
            try:
                if not f.is_file() or f.is_symlink() or f.stat().st_size > 50_000_000: continue
                contenu = f.read_bytes()
            except OSError: continue
            vus += 1
            cles = sorted({c for v, c in valeurs.items() if v in contenu})
            if cles: trouves[str(f).replace(str(HOME), "~")] = cles
    resume = (f"{datetime.datetime.now():%d/%m %H:%M} — " + ("aucune fuite" if not trouves else f"{len(trouves)} FICHIER(S) AVEC UN SECRET")
              + f" ({len(valeurs)} valeurs, {vus} fichiers)")
    (BERGER / "courtier/dernier-audit.txt").write_text(resume + "\n")
    print(f"Audit des secrets — {datetime.datetime.now():%d/%m/%Y %H:%M}")
    print(f"  {len(valeurs)} valeurs secrètes du coffre cherchées dans {vus} fichiers ({len(zones)} zones)")
    if not trouves:
        print("  ✓ aucune valeur du coffre trouvée en clair hors du coffre"); return 0
    print(f"  ✗ {len(trouves)} fichier(s) contiennent une valeur du coffre (NOM de la clé seulement) :")
    for f, cles in list(trouves.items())[:30]: print(f"    {f}\n        → {', '.join(cles)}")
    if len(trouves) > 30: print(f"    … et {len(trouves) - 30} autres")
    par_cle = {}
    for cles in trouves.values():
        for c in cles: par_cle[c] = par_cle.get(c, 0) + 1
    print("  Par clé : " + " · ".join(f"{c} ({n} fichiers)" for c, n in sorted(par_cle.items())))
    print("  À faire : nettoyer ces fichiers, puis CHANGER les clés concernées (rotation).")
    return 1


def verifier_depot(_=None):
    """Le dépôt Git ne doit contenir QUE le produit : aucune donnée d'agent, aucune configuration locale, aucune
    mention propre à l'installation (nom du propriétaire, dossier personnel, hôtes des outils, chemin du coffre),
    aucune valeur du coffre. Contrôle les fichiers suivis ET ceux prêts à être enregistrés (aussi lancé avant
    chaque commit par le hook .git/hooks/pre-commit). N'affiche jamais une valeur secrète."""
    r = subprocess.run(["git", "-C", str(BERGER), "ls-files", "--cached"], capture_output=True, text=True)
    fichiers = [f for f in r.stdout.splitlines() if f]
    interdits_chemins = re.compile(r"^(agents/|bibliotheque/|archives/|\.codex/|config\.toml$|commun/USER\.md$|courtier/.*\.log$|courtier/validations/|courtier/panneaux/|courtier/essai-ecritures\.txt$|.*dernier.*\.txt$|.*\.phrase$|tests/sondes-gardes\.txt$)")
    marques = {PROPRIETAIRE: "nom du propriétaire", str(HOME): "dossier personnel"}
    # Marques fixes du produit, indépendantes des réglages privés ; fragments pour ne pas se détecter soi-même.
    marques.update({m: "marque fixe du produit" for m in ("her" + "mes", "open" + "claw")})
    # Le chemin du coffre n'est une marque de l'installation que s'il diffère de celui du produit : le chemin par défaut
    # figure légitimement dans le code et dans config.exemple.toml (sinon 3 faux positifs sur une installation par défaut).
    if str(COFFRE).replace(str(HOME), "~") != COFFRE_DEFAUT:
        marques.update({str(COFFRE): "chemin du coffre", str(COFFRE).replace(str(HOME), "~"): "chemin du coffre"})
    for nom, o in CONFIG.get("outils", {}).items():
        for k in ("hote", "ip_secours", "cle"):
            if o.get(k): marques[o[k]] = f"réglage « {k} » de l'outil {nom}"
    for m in CONFIG.get("marques_privees", []): marques[m] = "marque privée (config.toml)"
    marques = {k: v for k, v in marques.items() if k and len(k) >= 3}
    parlant = re.compile(r"(?i)pass|pwd|mdp|motdepasse|secret|token|jeton|key|cle|clé|credential|auth|cookie|private|seed|pin")
    secrets = set()
    def parcourir(x, chemin=""):
        if isinstance(x, dict): [parcourir(v, k) for k, v in x.items()]
        elif isinstance(x, list): [parcourir(v, chemin) for v in x]
        elif isinstance(x, (str, int)) and len(str(x)) >= 8 and parlant.search(chemin) and not re.fullmatch(r"[a-z_ -]+|[A-Z_]+|https?://\S+|[~/][\w./-]*", str(x)):
            secrets.add(str(x))
    try: parcourir(json.loads(COFFRE.read_text()))
    except (OSError, ValueError): pass
    # Seule exception : l'URL exacte du dépôt public (`depot_public`, config.toml), qui peut porter une marque (identifiant
    # du propriétaire). Retirée du texte avant la recherche ; toute autre mention de la marque reste refusée.
    depot_public = CONFIG.get("depot_public")
    exception = (re.compile(r"(?<![\w./:@-])" + re.escape(depot_public) + r"(?![\w./-])")
                 if isinstance(depot_public, str) and re.fullmatch(r"https://[\w.-]+/[\w./-]+\.git", depot_public) else None)
    problemes = []
    for f in fichiers:
        if interdits_chemins.match(f): problemes.append((f, "fichier de données / configuration locale")); continue
        try: t = (BERGER / f).read_text(errors="ignore")
        except OSError: continue
        if any(v in t for v in secrets): problemes.append((f, "VALEUR DU COFFRE"))
        if exception: t = exception.sub(" ", t)
        for m, quoi in marques.items():
            # Une marque privée est refusée même collée à un point, un tiret ou un souligné (hôte, nom d'outil, de fichier) ;
            # le nom du propriétaire AUSSI à l'intérieur d'un mot (14/10 : « GO_<NOM> » dans tests/tout.sh, invisible en mot entier).
            avant, apres = (("", "") if m == PROPRIETAIRE
                            else (r"(?<![^\W_])", r"(?![^\W_])") if quoi == "marque privée (config.toml)"
                            else (r"(?<![\w.-])", r"(?![\w-])"))
            if re.search(r"(?i)" + avant + re.escape(m) + apres, t): problemes.append((f, quoi))
    if not problemes:
        print(f"dépôt propre : {len(fichiers)} fichiers suivis, aucune donnée ni mention de l'installation"); return 0
    print(f"✗ {len(problemes)} problème(s) dans le dépôt :")
    for f, quoi in problemes: print(f"   {f} — {quoi}")
    return 1


# ── installer : l'installation prend la forge locale ; retour arrière automatique si une vérification échoue ──
# Spec : docs/plans/2026-10-13-moins-validations-spec.md. Une seule commande, que lancent l'action `installer` de berger-admin
# (validée) et la suite d'une fusion validée du projet qui EST l'installation (`installer_outil` de [equipes.<p>]).
INSTALLATIONS = BERGER / "courtier/installations.log"


def git_installation(*a): return subprocess.run(["git", "-C", str(BERGER), *a], capture_output=True, text=True, timeout=300)
def tete_installation(): return git_installation("rev-parse", "HEAD").stdout.strip()


def trace_installation(avant, apres, etat, detail):
    INSTALLATIONS.parent.mkdir(parents=True, exist_ok=True)
    with open(INSTALLATIONS, "a") as f:
        f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S}\t{avant[:10]}\t{apres[:10]}\t{etat}\t{' '.join(detail.split())[:400]}\n")


def retour_arriere(avant):
    """L'installation revient au commit d'avant : `git reset --keep` (ni les fichiers non suivis — agents, config — ni une
    retouche locale ne sont écrasés : refus plutôt), preuve HEAD = avant, puis regenerer avec l'ancien code. → (ok, texte)."""
    r = git_installation("reset", "-q", "--keep", avant)
    if r.returncode or tete_installation() != avant:
        return False, (f"RETOUR ARRIÈRE IMPOSSIBLE vers {avant[:10]} ({(r.stderr or r.stdout).strip()[-200:]}) — à reprendre à la main : "
                       f"git -C {BERGER} reset --keep {avant} && berger regenerer")
    g = _transport.executer(str(BERGER / "bin/berger"), ['regenerer'], capture_output=True, text=True, timeout=600)
    if g.returncode: return False, f"retour arrière fait (HEAD = {avant[:10]}, vérifié) mais regenerer en ÉCHEC : {(g.stderr or g.stdout).strip()[-200:]}"
    return True, f"retour arrière fait : HEAD = {avant[:10]} (vérifié), regenerer refait"


def installer(forge, branche="main"):
    """L'installation prend <branche> de la forge LOCALE : avance rapide seule, HEAD = <branche> de la forge, verifier-depot,
    regenerer (le NOUVEAU code), puis redémarrage DÉTACHÉ et contrôlé du courtier (il attend que le résultat de la
    validation en cours soit inscrit). Une vérification en échec → retour arrière automatique au commit d'avant, tracé
    (courtier/installations.log) et notifié. → code de sortie."""
    avant = tete_installation()
    if not avant: print("l'installation n'est pas un dépôt git : rien installé"); return 1

    def echec(etape, sortie="", revenir=True):
        ok, texte = retour_arriere(avant) if revenir else (True, f"rien n'a changé (HEAD = {avant[:10]})")
        trace_installation(avant, tete_installation(), ("ÉCHEC, retour arrière" if revenir else "refusée") if ok else "ÉCHEC, À REPRENDRE",
                           f"{etape} — {texte}")
        notifier("Berger · installation en échec", f"{etape} — {texte}", urgent=True)
        print("\n".join(x for x in (f"✗ installation en ÉCHEC : {etape}", sortie.strip()[-1500:], texte) if x)); return 1

    r = git_installation("pull", "-q", "--ff-only", forge, branche)
    if r.returncode: return echec(f"avance rapide refusée depuis {forge} {branche}", r.stderr or r.stdout, revenir=tete_installation() != avant)
    apres = tete_installation(); tete = git_installation("ls-remote", forge, f"refs/heads/{branche}").stdout.split()[:1]
    if [apres] != tete: return echec(f"HEAD ({apres[:10]}) n'est pas {branche} de la forge ({(tete or ['?'])[0][:10]})")
    bilans = []
    for etape in ("verifier-depot", "regenerer"):                       # le NOUVEAU code, dans un processus à part
        c = _transport.executer(str(BERGER / "bin/berger"), [etape], capture_output=True, text=True, timeout=600)
        if c.returncode: return echec(f"{etape} en échec", c.stdout + c.stderr)
        bilans.append(f"{etape} : " + next((l.strip() for l in reversed(c.stdout.splitlines()) if l.strip()), "fait")[:120])
    lance = subprocess.run(["systemd-run", "--user", "--collect", str(BERGER / "bin/berger"), "courtier", "redemarrer", "--controle", avant],
                           capture_output=True, text=True)
    if lance.returncode: return echec("redémarrage du courtier non lancé", lance.stderr or lance.stdout)
    n = git_installation("rev-list", "--count", f"{avant}..{apres}").stdout.strip()
    trace_installation(avant, apres, "installée", f"{n} commit(s) ; {' ; '.join(bilans)} ; redémarrage du courtier lancé (contrôlé à part)")
    print(f"installée : {avant[:10]} → {apres[:10]} ({n} commit(s), {branche} de la forge) ; {' ; '.join(bilans)} ; redémarrage du courtier "
          f"lancé à part — contrôlé : s'il ne reste pas actif, retour arrière automatique à {avant[:10]} (courtier/installations.log)")
    return 0


def courtier_reste_actif(fois=3):
    """Le courtier RESTE actif : `fois` contrôles espacés (RestartSec = 5 s : un courtier qui plante au démarrage n'est pas
    « active » à chaque contrôle). Pour le redémarrage contrôlé seulement — jamais pour une vue : il dure jusqu'à 15 s
    (14/10 : sous le même nom que courtier_actif, il l'avait remplacé partout, Synthèse et Courtier mettaient 5 à 15 s)."""
    pause = float(os.environ.get("BERGER_CONTROLE_PAUSE", "5"))
    for _ in range(fois):
        time.sleep(pause)
        r = subprocess.run(["systemctl", "--user", "is-active", "berger-courtier"], capture_output=True, text=True)
        if r.stdout.strip() != "active": return False
    return True


# Redémarrage qui aboutit (spec docs/plans/2026-10-16-courtier-textes-spec.md, 3). Vécu le 16/10 : l'attente « plus aucune demande
# en cours » ne finissait pas (les portes des développeurs se relayaient) ; au bout de 15 min, exit 1 sans trace ni notification.
FERMETURE = BERGER / "courtier/fermeture"


def reglage_courtier(nom, defaut):
    try: return max(0, int((CONFIG.get("courtier") or {}).get(nom, defaut)))
    except (TypeError, ValueError): return defaut


def en_cours_courtier():
    """Ce que le courtier sert en ce moment : demandes d'agents en cours + action validée en cours (son résultat d'abord)."""
    return list(AGENTS.glob("*/courrier/encours/*.json")) + list((BERGER / "courtier/validations").glob("*.execution"))


def noms_en_cours(en_cours):
    return ", ".join(sorted({"validation n° " + x.stem if x.suffix == ".execution" else x.parts[-4] for x in en_cours}))


def redemarrer(controle=None, essai=1):
    """Pose la marque de fermeture (le courtier n'entame plus de nouvelle demande — sauf ses lectures instantanées — ni de décision), attend la fin de ce qui est EN
    COURS — borné par la plus longue, plus par le flux —, puis redémarre (contrôlé après `installer`). Abandon : tracé dans
    courtier/installations.log, notifié en urgence, nouvel essai lancé à part. → code de sortie."""
    attente, pas = reglage_courtier("redemarrage_attente", 900), float(os.environ.get("BERGER_REDEMARRAGE_PAS", "5"))
    def marquer():                                                       # rafraîchie à chaque tour : un redemarrer mort ne la laisse pas
        tmp = FERMETURE.with_suffix(".tmp"); tmp.write_text(json.dumps({"jusqu": time.time() + 2 * pas + 60, "depuis": debut, "essai": essai})); tmp.replace(FERMETURE)
    debut = time.time(); fin, dit = debut + attente, 0.0
    while True:
        marquer(); en_cours = en_cours_courtier()
        if not en_cours: break
        if time.time() >= fin: return redemarrage_abandonne(controle, essai, en_cours, attente)
        if time.time() - dit >= 60:
            print(f"{len(en_cours)} demande(s) en cours ({noms_en_cours(en_cours)}) : j'attends leur fin ; aucune nouvelle demande "
                  "n'est entamée", flush=True); dit = time.time()
        time.sleep(pas)
    try:
        if controle: return redemarrer_controle(controle)               # après `installer` : contrôlé, retour arrière sinon
        subprocess.run(["systemctl", "--user", "restart", "berger-courtier"], check=True); print("courtier redémarré"); return 0
    finally: FERMETURE.unlink(missing_ok=True)


def redemarrage_abandonne(controle, essai, en_cours, attente):
    """Jamais un exit 1 silencieux : la marque tombe (les demandes rangées repartent), trace, notification urgente, nouvel essai."""
    FERMETURE.unlink(missing_ok=True)
    essais, delai = reglage_courtier("redemarrage_essais", 12), reglage_courtier("redemarrage_reessai", 300)
    relance = "berger courtier redemarrer" + (f" --controle {controle}" if controle else "")
    suite = f"dernier essai : relance-le toi-même ({relance})"
    if essai < essais:
        r = subprocess.run(["systemd-run", "--user", "--collect", f"--on-active={delai}", str(BERGER / "bin/berger"), "courtier",
                            "redemarrer", *(["--controle", controle] if controle else []), "--essai", str(essai + 1)], capture_output=True, text=True)
        suite = (f"nouvel essai dans {delai // 60} min ({essai + 1}/{essais})" if r.returncode == 0
                 else f"nouvel essai NON lancé ({(r.stderr or r.stdout).strip()[-120:]}) : {relance}")
    tete = tete_installation()
    detail = f"essai {essai}/{essais} : {len(en_cours)} demande(s) encore en cours après {attente // 60} min ({noms_en_cours(en_cours)}) ; {suite}"
    trace_installation(controle or tete, tete, "redémarrage NON fait", detail)
    notifier("Berger · redémarrage du courtier NON fait", detail, urgent=True)
    print(f"redémarrage NON fait — {detail}"); return 1


def redemarrer_controle(avant):
    """Après `installer` : redémarre le courtier et contrôle qu'il reste actif ; sinon retour arrière automatique au commit
    d'avant, regenerer, redémarrage sur l'ancien code, tracé et notifié. → code de sortie."""
    if not re.fullmatch(r"[0-9a-f]{40}", avant or ""): print("--controle <commit complet d'avant l'installation>"); return 2
    apres = tete_installation()
    # l'interface web (si son service tourne) relit son serveur : try-restart ne démarre rien qui était arrêté
    relancer_interface = lambda: subprocess.run(["systemctl", "--user", "try-restart", "berger-interface"], capture_output=True, text=True)
    r = subprocess.run(["systemctl", "--user", "restart", "berger-courtier"], capture_output=True, text=True)
    if r.returncode == 0 and courtier_reste_actif():
        relancer_interface()
        trace_installation(avant, apres, "courtier redémarré", "actif après le redémarrage (contrôlé)"); print("courtier redémarré, actif (contrôlé)"); return 0
    ok, texte = retour_arriere(avant)
    r = subprocess.run(["systemctl", "--user", "restart", "berger-courtier"], capture_output=True, text=True)
    relancer_interface()
    actif = r.returncode == 0 and courtier_reste_actif()
    detail = (f"courtier inactif après le redémarrage sur {apres[:10]} — {texte} ; courtier redémarré sur l'ancien code : "
              + ("actif" if actif else "TOUJOURS INACTIF"))
    trace_installation(avant, tete_installation(), "ÉCHEC, retour arrière" if ok and actif else "ÉCHEC, À REPRENDRE", detail)
    notifier("Berger · installation en échec", detail, urgent=True)
    print(detail); return 1


def phrase_sauvegarde():
    """Phrase de chiffrement des sauvegardes, dans le trousseau système (jamais dans un fichier ni dans le dépôt).
    Créée au premier passage (32 octets aléatoires). Les agents ne peuvent pas joindre le trousseau (D-Bus fermé)."""
    attrs = ["service", "berger", "usage", "sauvegarde"]
    if not shutil.which("secret-tool"):
        # Serveur sans trousseau : fichier 600 (`phrase_fichier` de [sauvegarde]), dans un dossier MASQUÉ aux agents.
        f = Path(os.path.expanduser(CONFIG.get("sauvegarde", {}).get("phrase_fichier", "~/.config/berger/sauvegarde.phrase")))
        if f.exists(): return f.read_text().strip(), False
        import secrets as _s
        f.parent.mkdir(parents=True, exist_ok=True); os.chmod(f.parent, 0o700)
        phrase = _s.token_urlsafe(32); f.write_text(phrase + "\n"); os.chmod(f, 0o600); return phrase, True
    r = subprocess.run(["secret-tool", "lookup", *attrs], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip(): return r.stdout.strip(), False
    import secrets as _s
    phrase = _s.token_urlsafe(32)
    subprocess.run(["secret-tool", "store", "--label", "Berger — phrase de chiffrement des sauvegardes", *attrs],
                   input=phrase, text=True, check=True)
    return phrase, True


def sauvegarder():
    """Archive les DONNÉES de l'installation (tout ce que le dépôt Git ne contient pas, sauf .codex/ qui se
    régénère), la chiffre (GPG AES-256, phrase du trousseau) et l'envoie au WebDAV de [sauvegarde] ; garde les
    N dernières. Les identifiants WebDAV sont lus dans le coffre et passés à curl par l'entrée standard."""
    s = CONFIG.get("sauvegarde")
    if not s: print("pas de section [sauvegarde] dans config.toml"); return 2
    def valeur(chemin):
        d = json.loads(COFFRE.read_text())
        for k in chemin.split("."): d = d[k]
        return str(d)
    nom = f"berger-donnees-{datetime.datetime.now():%Y-%m-%d_%H%M}.tar.gz.gpg"
    tmp = Path(tempfile.mkdtemp(prefix="berger-sauvegarde-")); os.chmod(tmp, 0o700)
    try:
        suivis = set(subprocess.run(["git", "-C", str(BERGER), "ls-files"], capture_output=True, text=True).stdout.split())
        donnees = [p.name for p in BERGER.iterdir() if p.name not in (".git", ".codex") and p.name not in suivis
                   and not any(f.startswith(p.name + "/") for f in suivis)]
        donnees += [f for f in ("commun/USER.md", "tests/sondes-gardes.txt", "courtier/appels.log", "courtier/echanges.jsonl", "courtier/dernier-audit.txt")
                    if (BERGER / f).exists()]
        donnees += [str(p.relative_to(BERGER)) for p in (BERGER / "courtier").glob("appels-*.log")]
        donnees += [str(p.relative_to(BERGER)) for p in (BERGER / "courtier").glob("echanges-*.jsonl")]
        subprocess.run(["tar", "-czf", str(tmp / "d.tar.gz"), "-C", str(BERGER), "--exclude=*/.claude/skills",
                        "--exclude=*/.agents/skills", "--exclude=*/courrier", *sorted(set(donnees))], check=True,
                       capture_output=True)
        phrase, nouvelle = phrase_sauvegarde()
        subprocess.run(["gpg", "--batch", "--yes", "--pinentry-mode", "loopback", "--passphrase-fd", "0", "--symmetric",
                        "--cipher-algo", "AES256", "-o", str(tmp / nom), str(tmp / "d.tar.gz")], input=phrase, text=True,
                       check=True, capture_output=True)
        utilisateur = valeur(s["utilisateur_cle"])
        base = s["webdav"].replace("{utilisateur}", utilisateur).rstrip("/") + "/" + s["dossier"].strip("/")
        hote = re.match(r"https://([^/:]+)", base).group(1)
        auth = f'user = "{utilisateur}:{valeur(s["mot_de_passe_cle"])}"\n'
        def dav(*args):
            for extra in ([], ["--resolve", f"{hote}:443:{s['ip_secours']}"] if s.get("ip_secours") else None):
                if extra is None: break
                r = subprocess.run(["curl", "-s", "-K", "-", "--max-time", "120", "-w", "\n%{http_code}", *extra, *args],
                                   input=auth, capture_output=True, text=True)
                corps, _, code = r.stdout.rpartition("\n")
                if code and code != "000": return code, corps
            return "000", ""
        chemin = ""
        for morceau in s["dossier"].strip("/").split("/"):                 # créer les dossiers (déjà là = 405, normal)
            chemin += morceau + "/"
            dav("-X", "MKCOL", s["webdav"].replace("{utilisateur}", utilisateur).rstrip("/") + "/" + chemin)
        code, _ = dav("-T", str(tmp / nom), f"{base}/{nom}")
        if code not in ("201", "204"):
            notifier("Berger · sauvegarde", f"Échec de l'envoi (HTTP {code}).", urgent=True); print(f"échec de l'envoi : HTTP {code}"); return 1
        taille = (tmp / nom).stat().st_size
        # rotation : ne garder que les N dernières archives
        code, corps = dav("-X", "PROPFIND", "-H", "Depth: 1", f"{base}/")
        noms = sorted(set(re.findall(r"berger-donnees-[0-9_-]+\.tar\.gz\.gpg", corps)))
        for vieux in noms[:-int(s.get("garder", 14))]: dav("-X", "DELETE", f"{base}/{vieux}")
        (BERGER / "courtier/derniere-sauvegarde.txt").write_text(
            f"{datetime.datetime.now():%d/%m %H:%M} — {nom} ({taille // 1024} Ko, chiffrée) · {min(len(noms), int(s.get('garder', 14)))} conservées\n")
        print(f"sauvegarde envoyée : {s['dossier']}/{nom} ({taille // 1024} Ko, chiffrée)")
        if nouvelle:
            print("⚠ Phrase de chiffrement CRÉÉE dans le trousseau. Recopie-la dans ton gestionnaire de mots de passe, "
                  "depuis un terminal à toi : secret-tool lookup service berger usage sauvegarde")
            notifier("Berger · sauvegarde", "Phrase de chiffrement créée : recopie-la dans ton gestionnaire de mots de passe "
                     "(secret-tool lookup service berger usage sauvegarde).")
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def verifier_sauvegarde():
    """Télécharge la DERNIÈRE archive depuis le WebDAV, la déchiffre dans un dossier temporaire et compare aux
    fichiers locaux (empreintes). Une sauvegarde qu'on n'a jamais relue ne prouve rien."""
    import hashlib
    s = CONFIG["sauvegarde"]
    def valeur(chemin):
        d = json.loads(COFFRE.read_text())
        for k in chemin.split("."): d = d[k]
        return str(d)
    utilisateur = valeur(s["utilisateur_cle"])
    base = s["webdav"].replace("{utilisateur}", utilisateur).rstrip("/") + "/" + s["dossier"].strip("/")
    auth = f'user = "{utilisateur}:{valeur(s["mot_de_passe_cle"])}"\n'
    r = subprocess.run(["curl", "-s", "-K", "-", "-X", "PROPFIND", "-H", "Depth: 1", f"{base}/"], input=auth, capture_output=True, text=True)
    noms = sorted(set(re.findall(r"berger-donnees-[0-9_-]+\.tar\.gz\.gpg", r.stdout)))
    if not noms: print("aucune sauvegarde trouvée"); return 1
    tmp = Path(tempfile.mkdtemp(prefix="berger-verif-")); os.chmod(tmp, 0o700)
    try:
        subprocess.run(["curl", "-s", "-K", "-", "-o", str(tmp / noms[-1]), f"{base}/{noms[-1]}"], input=auth, check=True, capture_output=True, text=True)
        restaurer(str(tmp / noms[-1]), str(tmp / "r"))
        empreinte = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
        ref = [p for p in (BERGER / "agents").rglob("*") if p.is_file() and not p.is_symlink() and "/courrier/" not in str(p)
               and "/.claude/" not in str(p) and "/.agents/" not in str(p)] + [BERGER / "config.toml"]
        ok = sum(1 for p in ref if (tmp / "r" / p.relative_to(BERGER)).exists() and empreinte(tmp / "r" / p.relative_to(BERGER)) == empreinte(p))
        # un fichier modifié APRÈS la sauvegarde (journal du jour…) peut différer : on le signale sans conclure à l'échec
        print(f"{noms[-1]} : déchiffrée, {ok}/{len(ref)} fichiers identiques aux fichiers locaux ({len(noms)} archives sur le serveur)")
        return 0 if ok >= len(ref) * 0.9 else 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def restaurer(archive, destination):
    """Déchiffre une archive de sauvegarde (fichier local) dans un dossier, pour vérifier ou récupérer."""
    phrase, _ = phrase_sauvegarde()
    Path(destination).mkdir(parents=True, exist_ok=True)
    gz = Path(destination) / "donnees.tar.gz"
    subprocess.run(["gpg", "--batch", "--yes", "--pinentry-mode", "loopback", "--passphrase-fd", "0", "-d", "-o", str(gz), archive],
                   input=phrase, text=True, check=True, capture_output=True)
    subprocess.run(["tar", "-xzf", str(gz), "-C", destination], check=True); gz.unlink()
    print(f"archive déchiffrée dans {destination}")


def coffre_sauvegarder(motif=None):
    """Copie CHIFFRÉE du coffre avant de le modifier (08/10/2026 : 7 copies EN CLAIR « coffre….avant-* » laissées par la règle
    « copie datée » ont dû être effacées). age (age-encryption.org) vers la clé PUBLIQUE de [coffre_sauvegarde] : la clé privée
    n'est jamais sur cette machine (gestionnaire de mots de passe du propriétaire), une fuite du dossier ne donne rien.
    Sans motif : purge seule (au-delà de garder_jours, appelée aussi par l'entretien). N'imprime aucune valeur."""
    s = CONFIG.get("coffre_sauvegarde") or {}
    dossier_s = Path(os.path.expanduser(s.get("dossier", "~/sauvegardes/coffre"))); jours = int(s.get("garder_jours", 7))
    def purger():
        n = 0
        for f in dossier_s.glob("coffre-*.age") if dossier_s.is_dir() else []:
            if time.time() - f.stat().st_mtime > jours * 86400: f.unlink(); n += 1
        return n
    if motif is None: return purger()
    dest = str(s.get("destinataire", "")).strip()
    if not re.fullmatch(r"age1[0-9a-z]{20,}", dest): sys.exit("[coffre_sauvegarde] destinataire (clé PUBLIQUE age1…) absent de config.toml : aucune sauvegarde, ne modifie pas le coffre")
    if not re.fullmatch(r"[\w.-]{1,60}", motif): sys.exit("motif : lettres, chiffres, . _ - (60 au plus), ex. avant-outil-glpi")
    if not shutil.which("age"): sys.exit("age n'est pas installé (paquet « age ») : aucune sauvegarde, ne modifie pas le coffre")
    dossier_s.mkdir(parents=True, exist_ok=True); os.chmod(dossier_s, 0o700)
    sortie = dossier_s / f"coffre-{datetime.datetime.now():%Y%m%d-%H%M%S}-{motif}.json.age"
    r = subprocess.run(["age", "-r", dest, "-o", str(sortie), str(COFFRE)], capture_output=True, text=True)
    if r.returncode != 0 or not sortie.is_file(): sys.exit("ÉCHEC du chiffrement : AUCUNE sauvegarde — ne modifie pas le coffre")
    os.chmod(sortie, 0o600)
    with open(sortie, "rb") as f: entete = f.read(21)
    if entete != b"age-encryption.org/v1" or sortie.stat().st_size < COFFRE.stat().st_size:
        sortie.unlink(); sys.exit("sauvegarde NON conforme (en-tête ou taille) : supprimée — ne modifie pas le coffre")
    print(f"sauvegarde chiffrée vérifiée : {sortie}")
    print(f"RETOUR ARRIÈRE : clé privée (gestionnaire de mots de passe) dans un fichier 600, puis "
          f"age -d -i <fichier-clé> {sortie} > {COFFRE} && shred -u <fichier-clé>")
    n = purger()
    if n: print(f"purge : {n} sauvegarde(s) de plus de {jours} jours effacée(s)")
    return 0


def secrets_audit_silencieux():
    import io, contextlib
    with contextlib.redirect_stdout(io.StringIO()): return secrets_audit()


