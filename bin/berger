def verbe_espace_voulu(args, prive=False):                                           # lecture seule : ce que les règles demandent (rien n'est changé)
    pos = [x for x in args if x != "--json"]
    if len(pos) != 1: sys.exit("berger espace-voulu <agent> [--json]")
    d = espace_voulu(pos[0] if pos[0] in agents() else sys.exit(f"agent inconnu : {pos[0]} (agents : {', '.join(agents()) or 'aucun'})"))
    print(json.dumps(enveloppe("espace-voulu", SCHEMAS / "espace-voulu.schema.json", d), ensure_ascii=False, indent=1) if "--json" in args else espace_voulu_texte(d))

