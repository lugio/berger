def verbe_memoire(args, prive=False):                                                # verifier|valider|refuser [<agent>] <proposition> : porte de perte + sauvegarde
    sous = args[0] if args else ""; a = args[1] if len(args) > 2 else os.environ.get("BERGER_AGENT")
    if sous not in ("verifier", "valider", "refuser") or not a or len(args) < 2: sys.exit("berger memoire verifier|valider|refuser [<agent>] <proposition>")
    prop = next((p for p in (Path(args[-1]), dossier(a) / args[-1], dossier(a) / "pending" / Path(args[-1]).name) if p.is_file()), None)
    if not prop: sys.exit(f"proposition introuvable : {args[-1]} (pending/ de {conf(a)['nom']} : {', '.join(sorted(p.name for p in (dossier(a) / 'pending').glob('*.md'))) or 'vide'})")
    if sous == "refuser":
        prop.unlink(); journal(a, f"mémoire : proposition {prop.name} refusée et retirée"); print(f"refusée : {prop.name}")
    else:
        ok, detail, resultat = memoire_verifier(a, prop); print("\n".join(detail))
        if not ok: sys.exit(f"REFUSÉ : {prop.name} n'est pas appliquée")
        if sous == "valider": print(f"appliquée : {prop.name} → {fichier_memoire(a)} (sauvegarde {memoire_appliquer(a, prop, resultat).name})")
        else: print("acceptable")

def verbe_vue(args, prive=False): sys.exit(commande_vue(args))


